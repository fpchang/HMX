<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>

				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 18px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("hotel.room_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="navbar-btn">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>

				<text class="txt"
					@click="addRoom">{{i18n.global.t("hotel.title_room")}}</text>


			</view>
		</template>
	</rice-navbar>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->


		<view class="search-area">

			<view class="card">
				<view class="card-item title-area">
					<text class="txt">{{i18n.global.t("hotel.room_filter")}}</text>
					<l-tag variant="light">{{ i18n.global.t('common.totalCount',[filterRoomList.length]) }}</l-tag>
				</view>
				<view class="card-item  select-area">
					<xt-select :columns="columns" v-model="_select_id"
						:placeholder="i18n.global.t('hotel.pach_search_room_name')"
						@searchInputChange="searchInputChange"></xt-select>
				</view>
				<view class="card-item search"></view>
			</view>

		</view>
		<view style="padding:14px;border-radius: 14px;">
			<view style="border-radius: 14px;background-color: #fff;"> 
			  <rice-swipe-actions :accordion="true" ref="swipeControlRef">
			    <rice-swipe-actions-item  :auto-close="true" v-for="room of filterRoomList">
			      <rice-cell :title="room.room_name" :label="getRoomTypeName(room.room_type_id)" size="large" arrow arrow-direction="left"  center :clickable="false" >
					   <template #leftIcon>
					     <image src="/static/icons/roomReserve.png" style="width: 50px;height:50px;" class="left-cion"></image>
					   </template>
					  <template #rightIcon>
						  <rice-icon name="double-left"  style="margin-left: 15px;"/>
					  </template>
				  </rice-cell>
			      <template #right>
			        <view class="swiper-menu-style" >
						<view class="menu-item edit" @click="editRoom(room)">
						  <rice-icon name="edit" color="#fff" />
						  <text class="slot-text">编辑</text>
						</view>
			          <view class="menu-item del" @click="deleteRoom(room)">
			            <rice-icon name="delete" color="#fff" />
			            <text class="slot-text">删除</text>
			          </view>
			         
			      
			        </view>
			       
			      </template>
			    </rice-swipe-actions-item>
			  </rice-swipe-actions>
			</view>			
		</view>
		
		<view class="card-list" v-if="false">
			<!-- <template v-for="roomType of filterRoomTypeList"> -->
			<view class="card-list-item" v-for="room of filterRoomList">
				<view class="card">
					<view class="card-item title">
						<text class="txt">{{room.room_name}}</text>
					</view>
					<view class="card-item subtitle">
						<text class="txt">
							{{getRoomTypeName(room.room_type_id)}}
						</text>
					</view>
					<view class="card-item">
						<xt-control @del="deleteRoom(room)" @edit="editRoom(room)" :show-view="false"></xt-control>
					</view>
				</view>
			</view>
			<!-- </template> -->
		</view>
		<l-empty :description="i18n.global.t('common.noData',[''])" v-if="!submitLoading&&filterRoomList.length<1" />
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->

</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { roomBean } from '@/bean/roomBean';
	import { state } from "@/store/store";
	import { roomTypeService } from "@/services/roomTypeService";
	import { comFunction } from "@/pages/index/ComFuc";
	import { userBean } from "@/bean/userBean";
	import { SwipeActionsMenu, SwipeActionsItemClick, SwipeActionsItemOpen, SwipeActionsItemClose } from '@/uni_modules/rice-ui'
	import i18n from '@/i18n/index.uts';
	let submitLoading = ref(false);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const user = computed<userBean>(() => {
		return state.user;
	});
	const permissionList = computed(() => {
		return state.permissionList;
	});
	const roomTypeList = computed<Array<roomTypeBean> | null>(() => {
		return state.roomTypeList;
	});
	//选择列表
	let _select_id = ref("all");
	let _search_key = ref("");
	const columns = computed<Array<Array<PickerOption>>>(() => {
		if (roomTypeList.value == null) {
			return []
		}
		let result : Array<Array<PickerOption>> = [];
		let list : Array<PickerOption> = [{ text: i18n.global.t("hotel.all_roomType"), value: "all" }];
		// let result : Array<Array<PickerOption>> = [];
		// let list = roomTypeList.value.map(item => {
		// 	return { text: item.name, value: item._id } as PickerOption
		// }) as Array<PickerOption>;
		// result[0].unshift({ text: "全部房型", value: "all" } as PickerOption);
		// return result;
		roomTypeList.value.forEach(item => {
			list.push({ text: item.name, value: item._id } as PickerOption);
		});
		result.push(list);
		return result;
	});

	let filterRoomList = computed<Array<roomBean>>(() => {
		if (roomTypeList.value == null) {
			return []
		}
		let roomList : Array<roomBean> = [];
		roomTypeList.value.forEach(item => {
			if (_select_id.value == "all" || _select_id.value == item._id) {
				item.roomList.forEach(it => {
					if (it.room_name.includes(_search_key.value)) {
						roomList.push(it);
					}

				})
			}

		});
		return roomList;
	});
	const searchInputChange = (value : string) => {
		_search_key.value = value;
	}
	const selectRoomType = (val : string) => {
		console.log("val", val)
		if (_select_id.value == val) {
			return;
		}
		_select_id.value = val;
	}
	// const getRoomNum = computed<number>(() => {
	// 	let num = 0;
	// 	if (filterRoomTypeList.value != null) {
	// 		filterRoomTypeList.value.forEach(item => {
	// 			num += item.roomList.length;
	// 		})
	// 	}
	// 	return num;

	// })
	const getRoomTypeName = (room_type_id : string) : string => {
		if (roomTypeList.value != null) {
			let obj = roomTypeList.value.find(item => item._id == room_type_id) as roomTypeBean;
			return obj.name;
		}
		return "-"
	}
	const swipeControlRef  = ref<RiceSwipeActionsComponentPublicInstance  | null>(null)
				const closeSwiper = () => {
				  swipeControlRef.value!.closeAll!();
				}
	const addRoom = async () => {
		if (!permissionList.value.includes(
			"ROOMTYPE_CREATE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		if (roomTypeList.value != null && roomTypeList.value.length < 1) {
			uni.showToast({
				title: i18n.global.t("hotel.tips_create_room_type"),
				icon: 'none'
			})
			return;
		}
		uni.navigateTo({
			url: `/pages/hotelManage/createRoom/createRoom`
		});
	}
	const deleteRoom = async (room : roomBean) => {
		if (submitLoading.value == true) {
			return;
		}
		if (!permissionList.value.includes(
			"ROOMTYPE_DELETE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),

			beforeClose: async () : Promise<boolean> => {
				try {
					const flag = await roomTypeService.deleteRoom(room._id);
					if(flag){
						await comFunction.getRoomTypeList(hotel_id.value);
						hideDialog();
						uni.showToast({
							title: i18n.global.t("common.delete_success"),
							icon: "none"
						});
						closeSwiper();
						return true;
					}
					return false;
				} catch (e) {
					uni.showToast({
						title: i18n.global.t("common.system_error"),
						icon: "none"
					});
					return false;
				}
			},
			confirm: () => {
			}, cancel: () => {
				hideDialog();
			}

		});
	}
	const editRoom = async (room : roomBean) => {
		if (!permissionList.value.includes(
			"ROOMTYPE_UPDATE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		closeSwiper();
		uni.navigateTo({
			url: `/pages/hotelManage/editRoom/editRoom?pageType=1&&room=${encodeURIComponent(JSON.stringify(room))}`,
		});
	}
	

	
	


	onLoad(params => {

		try {
			const roomType_id = params.getString("roomType_id") ?? "";
			if (roomType_id != "") {
				selectRoomType(roomType_id);
			}

		} catch (e) { }
	})
</script>

<style lang="scss">
	.search-area {
		padding: 18px;

		.card {
			background-color: #fff;
			border-radius: 8px;
			padding: 16px;

			.card-item {
				margin-bottom: 15px;

				&:last-child {
					margin: 0;
				}
			}

			.title-area {
				display: flex;
				flex-direction: row;
				align-items: center;

				.txt {
					padding-right: 8px;
					font-size: 18px;
					font-weight: 700;
					color: #999;
				}
			}

		}
	}
	.swiper-menu-style{
		display: flex;
		flex-direction: row;
		height: 100%;
		.menu-item{
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			padding:0 15px;
			// border-radius: 8px;
			.slot-text{
				color:#fff;
				font-size: 14px;
				padding-left: 4px;
			}
			
		}
		.del{
			background-color: #F56C6C ;
		}
		.edit{
			background-color: #409EFF ;
		}
		 
	}
	.card-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;

		.card-list-item {
			min-width: 360px;
			padding: 15px;
			flex: 1;

			.card {


				background-color: #fff;
				border-radius: 12px;
				padding: 16px;

				.card-item {
					margin-bottom: 12px;

					&:last-child {
						margin-bottom: 0;
					}
				}

				.title {
					.txt {
						font-size: 18px;
						font-weight: 700;
						color: #1d2129;
					}

				}

				.subtitle {
					.txt {
						color: #6b7280;
						font-size: 14px;
					}
				}
			}
		}
	}
</style>