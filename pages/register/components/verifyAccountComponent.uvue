<template>
	<view class="page">
		<view class="card">
			<rice-form :model="userForm" :rules="registerRule" ref="userFormRef" label-width="100px" class="demo-form">
				<rice-form-item name="account" label-position="top">
					<rice-input v-model="userForm['account']" placeholder="请输入用户名" border="none" />
				</rice-form-item>
				<rice-form-item name="password" required label-position="top">
					<rice-input v-model="userForm['password']" placeholder="请输入密码" border="none" type="password" />
				</rice-form-item>
				<rice-form-item name="confirmPassword" required label-position="top">
					<rice-input v-model="userForm['confirmPassword']" placeholder="请再次输入密码" border="none"
						type="password" />
				</rice-form-item>
			</rice-form>
			<view style="margin-top: 24px;">
				<rice-button type="primary" text="完成注册" class="btn" shape="round" @click="accountEvent"
					:loading="submitLoading" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { FormRules, FormValidateErrors } from "@/uni_modules/rice-ui";
	import { AccountService } from "@/services/AccountService";
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	const submitLoading = ref(false);
	type userType = {
		account : string,
		password : string,
		confirmPassword : string
	}
	const userForm = ref<userType>({
		account: '',
		password: '',
		confirmPassword: ''
	});
	
	const userFormRef = ref<RiceFormComponentPublicInstance | null>(null);
	const codeText = ref('获取验证码');
	const codeDisabled = ref(false);
	const validAccount = async (account : any | null) => {
		if (account == null) {
			return "账号不能为空";
		}
		const flag = await AccountService.validRegisterAccount(account.toString());
		return !flag;
	}
	
	//密码的校验函数
	const passwordValidator = (value : any | null) => {
		const val = value as string
		if (val.length < 6) return '密码的长度不能小于6位'
		//if (val.startsWith('123456')) return '密码开头不能为连续的123456'
		//只有返回 true 才表示校验通过
		return true
	}
	const passwordConfirmValidator = (value : any | null) => {
		const val = value as string
		if (val.length < 6) return '密码的长度不能小于6位'
		// if (val.startsWith('123456')) return '密码开头不能为连续的123456';
		if (val != userForm.value.password) {
			return "两次输入的密码不一致"
		}
		//只有返回 true 才表示校验通过
		return true
	}
	const registerRule = new Map<string, FormRules[]>([
		[
			"account",
			[
				{ required: true, message: '请输入用户名' },
				{ min: 3, max: 15, message: '字数需为 3 至 15 位', trigger: 'blur' },
				{ validator: validAccount, trigger: 'blur', message: "已存在相同用户名" }
			]
		], 
		[
			"password",
			[
				//函数校验
				{ validator: passwordValidator },
				//正则校验
				{ pattern: /[a-zA-Z].*\d|\d.*[a-zA-Z]/, message: '密码需要包含字母和数字' },
			]
		],
		[
			"confirmPassword",
			[
				//函数校验
				{ validator: passwordConfirmValidator },
				//正则校验
				{ pattern: /[a-zA-Z].*\d|\d.*[a-zA-Z]/, message: '密码需要包含字母和数字', trigger: 'change' },
			]
		]
	])

	const accountEvent=()=>{}

</script>
<style scoped lang="scss">
	.page {
		flex: 1;
		// background: linear-gradient(180deg, #f2f5f9 0%, #e6ebf5 100%);
		padding: 0 16px;
		box-sizing: border-box;
	}

	.card {
		background: #ffffff;
		padding-top: 60px;
		border-radius: 20px;
		padding: 40px 20px;
		// box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
	}

	.title {

		text-align: center;
		margin-bottom: 40px;

		.txt {
			font-size: 32px;
			font-weight: 600;
			color: #1d1d1f;
		}
	}

	.input-box {
		margin-bottom: 20px;
		border-bottom: 0.5px solid #e5e7eb;
		background-color: #fff;
		border-radius: 25px;
	}

	.input {
		height: 50px;
		padding: 0 16px;
		font-size: 16px;
		color: #1d1d1f;
	}

	.ph {
		color: #8e8e93;
	}

	.btn-register {
		margin-top: 35px;
		width: 100%;
		height: 50px;
		line-height: 50px;
		background: #007aff;
		color: #fff;
		border-radius: 25px;
		font-size: 17px;
		font-weight: 500;
		border: none;
	}

	.input-row {

		width: 100%;
		height: 100%;
		display: flex;
		flex: 1;
		flex-direction: row;
		justify-content: space-between;

		overflow: hidden;
	}

	.btn-code {
		font-size: 14px;
		color: #007aff;
		background: #fff;
		border: none;
		outline: none;
		padding: 0 8px;
		margin: 0 4px;
	}

	.btn-code[disabled] {
		color: #8e8e93;
	}
</style>