<template>
	<view>
		<view class="app-split">
			<view class="con-box" v-if="phone!=''">
				<view style="display: flex;flex-direction: row;align-items: center;justify-content: center;">
					<text class="tit-text">{{phone}}</text>
				</view>
				<view><text class="ct-text">{{i18n.global.t('login.tips')}}</text></view>
			</view>
			<view class="con-box" v-if="phone==''">
				<view style="display: flex;flex-direction: row;justify-content: center;">
					<rice-loading color="#787878" :text="i18n.global.t('login.getphone_loading')" />
				</view>
			</view>
			<view class="btn-content">
				<rice-button type="primary" :text="i18n.global.t('login.btn_app_txt')" class="btn" shape="round" @click="verify(false)"
					:loading="submitLoading" />
			</view>
		</view>
	</view>
</template>

<script setup>
	import { AccountService } from "@/services/AccountService";
	import i18n from '@/i18n/index.uts';
	import { setToken } from "@/store/store.uts";
	defineOptions({
		styleIsolation: "isolated"
	})
	const props = defineProps({
		isAgree: {
			type: Boolean,
			default: false
		}
	});
	const uniVerifyManager = ref(null as UniVerifyManager | null)
	const phone = ref('')
	const slogan = ref('')
	const privacyName = ref('')
	const privacyUrl = ref('')

	let submitLoading = ref(false);
	const preLogin = (callback : (() => void)) => {
		uniVerifyManager.value?.preLogin({
			success: (res) => {
				phone.value = res.number;
				slogan.value = res.slogan;
				privacyName.value = res.privacyName;
				privacyUrl.value = res.privacyUrl;
				console.log("pre login success");
				callback();
			},
			fail: (err) => {
				console.error("pre login fail => " + JSON.stringify(err));
				const hasCauseMessage = (err.cause?.cause?.message ?? '').length > 0
				uni.showModal({
					title: i18n.global.t('login.pre_login_fail'),
					content: hasCauseMessage ? JSON.parseObject(err.cause?.cause?.message ?? '')?.getString("errorDesc") : err.errMsg,
					showCancel: false
				});
			}
		});
	}
	const takePhoneNumber = async (accessToken : string, openid : string) => {
		const userForm = {
			loginType: "app",
			accessToken: accessToken,
			openid: openid
		}
		submitLoading.value = true;
		const flag = await AccountService.LoginByAPP(userForm);
		if (flag) {
			uni.reLaunch({
				url: "/pages/index/index",
			});
		}
		submitLoading.value = true;
	}

	const login = (fullScreen : boolean) => {
		uniVerifyManager.value?.login({
			uniVerifyStyle: {
				fullScreen: fullScreen,
				loginBtnText:i18n.global.t('login.btn_app_txt'),
				logoPath: "/static/images/ys.png"
			},
			success: (res) => {
				console.log("login success => " + JSON.stringify(res));
				takePhoneNumber(res.accessToken, res.openId);
			},
			fail: (err) => {
				console.error("login fail => " + err);
				submitLoading.value = false;
			}
		});
	}

	const verify = (fullScreen : boolean) => {
		if (uniVerifyManager.value == null) {
			uni.showToast({
				title: i18n.global.t('login.no_support_login_app'),
				icon: "none",
			});
			return;
		}
		if (!props.isAgree) {
			uni.showToast({
				title:i18n.global.t('login.valid_login_app_agree'),
				icon: "none",
			});
			return;
		}
		if (submitLoading.value == true) {
			return;
		}
		if ('production' === process.env.NODE_ENV && '__UNI__HelloUniAppX' === uni.getAppBaseInfo().appId) {
			return
		}
		submitLoading.value = true;
		const isPreLoginValid = uniVerifyManager.value?.isPreLoginValid() ?? false;
		if (isPreLoginValid) {
			login(fullScreen);
		} else {
			preLogin(() => {
				login(fullScreen);
			})
		}
	}

	onLoad(() => {
		uniVerifyManager.value = uni.getUniVerifyManager();
		preLogin(() => { });
	})
</script>

<style>
.app-split {
	margin-top:24px;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.split-line-wrapper {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 15px;
	width: 100%;
}
.split-line {
	flex: 1;
	height: 0.5px;
	background-color: #e0e0e0;
}
.split-line-text {
	padding: 0 10px;
	font-size: 12px;
	color: #999999;
}
.con-box {
	width: 100%;
}
.tit-text {
	text-align: center;
	font-size: 24px;
}
.ct-text {
	font-size: 12px;
	color: gray;
	padding-top: 8px;
	text-align: center;
}
.btn-content {
	width: 100%;
	margin: 24px 0 12px 0;
}
.btn-login {
	width: 100%;
	height: 50px;
	line-height: 50px;
	background-color: #007aff;
	color: #fff;
	font-size: 17px;
	font-weight: 500;
	border-radius: 25px;
	border: none;
}
</style>