class DBConnect{
  constructor(){
  }

  async callFunction(name:string,data:UTSJSONObject={}):Promise<UniCloudCallFunctionResult<UTSJSONObject>>{
  
	let groupData = UTSJSONObject.assign(data,{
        $user:uni.getStorageSync('user'),
        $token:uni.getStorageSync('hm_token')
      });

    // 检查是否需要转发到 hm_action_co 云对象
    const mapping = cloudFunctionMap.get(name);
    if (mapping != null) {
        const [methodName, moduleName] = mapping;
        return await this.callActionCo(methodName, groupData);
    }

	return  uniCloud.callFunction({
	  	name:name,
	  	data:groupData
	  })
  }

  // 调用 hm_action_co 云对象
  async callActionCo(methodName: string, data: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
      const action_co = uniCloud.importObject("hm_action_co");
      try {
          const result = await (action_co as UTSJSONObject)[methodName](data);
          return {
              result: result as UTSJSONObject,
              errMsg: "",
              requestId: ""
          } as UniCloudCallFunctionResult<UTSJSONObject>;
      } catch (error) {
          throw error;
      }
  }

   getCollection(dbName:string,w:(string | UTSJSONObject)):Promise<UniCloudDBGetResult>{
	   let wh = w;
	   if(w==""){
		   wh ={}
	   }
    return  uniCloud.databaseForJQL().collection(dbName).where(wh).limit(50000).get();
  
  }
   getCollectionOrderBy(dbName:string,w:(string | UTSJSONObject),orderBy="_id desc"):Promise<UniCloudDBGetResult>{
    return uniCloud.databaseForJQL().collection(dbName).where(w).orderBy(orderBy).get();
  }
   insertData(dbName:string,r:UTSJSONObject={}):Promise<UniCloudDBAddResult>{
    return uniCloud.databaseForJQL().collection(dbName).add(r);

  }
   add(dbName:string,r:UTSJSONObject={}):Promise<UniCloudDBAddResult>{
      return uniCloud.databaseForJQL().collection(dbName).add(r)  
  }
   update(dbName:string,_id:string="",data:UTSJSONObject={}):Promise<UniCloudDBUpdateResult>{
    return uniCloud.databaseForJQL().collection(dbName).doc(_id).update(data);
  }
   remove(dbName:string,_id:string):Promise<UniCloudDBRemoveResult>{
    return uniCloud.databaseForJQL().collection(dbName).doc(_id).remove();
  }
   clearnTable(dbName:string){
// 		const dbCmd = uniCloud.databaseForJQL().command
//  uniCloud.databaseForJQL().collection(dbName).where({
//   _id: dbCmd.exists(true);
// }).remove()
  }
}
