		bgColor: "#165dff1a",
		url: "/pages/order/createOrder/createOrder",
		show: permissionList.value.includes("FM_CREATE")
	},
	{
		icon: "/static/icons/homemenu/v2/income.png",
		title:i18n.global.t("common.btn_txt_create",[i18n.global.t("finance.title_income_expense")]),
		label:i18n.global.t("home.recordAccountsIncomeExpense"),//"记录账目与收支明细",
		bgColor: "#722ed11a",
		url: "/pages/financialManagement/inExManage/createIncomeAndExpense/createIncomeAndExpense?billType=income",
