<template>
	<rice-navbar title="">
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>
				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("finance.income_expense_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="navbar-btn-root" @click="addFm">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>
				<text class="navbar-text">{{billType=='income'?i18n.global.t("finance.income"):i18n.global.t("finance.expense")}}</text>
			</view>
		</template>
	</rice-navbar>
	<scroll-view style="flex:1">
		<view class="search-wrap-root">
			<view class="search-card-box">
				<view class="search-card-row title-row">
					<text class="title-text">{{i18n.global.t("finance.income_expense_filter")}}</text>
					<l-tag variant="light">{{ i18n.global.t('common.totalCount',[fmResult.count.toString()]) }}</l-tag>
				</view>
				<view class="search-card-row select-row">
					<fmSearchComponent :columns="columns" :initDateRange="dateRange"
						@searchInputChange="searchInputChange" @selectAction="selectFm" @dateChange="dateChange"
						@searchAction="getFmList" :placeholder="i18n.global.t('form.pach_remark')"></fmSearchComponent>
				</view>
			</view>
		</view>

		<view style="padding:14px;border-radius: 14px;">
			<view style="border-radius: 14px;background-color: #fff;">
				<rice-swipe-actions :accordion="true" ref="swipeControlRef">
					<rice-swipe-actions-item :auto-close="true" v-for="fm of fmResult.fmList">
						<rice-cell :title="`${formatTypeName(fm.type)}`" :label="formatDate(fm.ioeTime)"
							:value="`${fm.billType=='income'?'+':'-'}${fm.amount}`" size="large" arrow
							arrow-direction="left" center>
							<template #leftIcon>
								<image v-if="fm.billType=='income'" src="/static/icons/fm/income-orange.png"
									style="margin-right:8px;width: 40px;height:40px;" class="cell-left-icon"></image>
								<image v-if="fm.billType=='expenses'" src="/static/icons/fm/expense-orange.png"
									style="margin-right:8px;width: 40px;height:40px;" class="cell-left-icon"></image>
							</template>
							<template #rightIcon>
								<rice-icon name="double-left" color="#909399" style="margin-left: 15px;" />
							</template>
						</rice-cell>
						<template #right>
							<view class="swipe-menu-container">
								<view class="menu-item-box menu-detail" @click="viewFm(fm)">
									<rice-icon name="eyes" color="#fff" />
									<text class="menu-item-text">{{i18n.global.t("common.btn_txt_details",[''])}}</text>
								</view>
								<view class="menu-item-box menu-edit" @click="editFm(fm)">
									<rice-icon name="edit" color="#fff" />
									<text class="menu-item-text">{{i18n.global.t("common.btn_txt_edit")}}</text>
								</view>
								<view class="menu-item-box menu-del" @click="deleteFm(fm)">
									<rice-icon name="delete" color="#fff" />
									<text class="menu-item-text">{{i18n.global.t("common.btn_txt_delete")}}</text>
								</view>
							</view>
						</template>
					</rice-swipe-actions-item>
				</rice-swipe-actions>
			</view>
		</view>

		<view v-if="submitLoading" style="display: flex;flex-direction: row;justify-content: center;">
			<rice-loading color="#787878" :text="i18n.global.t('common.loading')" />
		</view>
		<view v-if="!submitLoading&&fmResult.fmList.length<1">
			<l-empty :description="i18n.global.t('common.noData',[''])" />
		</view>
	</scroll-view>

	<view style="padding:15px 5px;background-color: #fff;display: flex;flex-direction: row;justify-content: center;"
		v-if="!submitLoading&&fmResult!=null&&fmResult.count>fmResult.pageSize">
		<l-pagination v-model="fmResult.pageNo" :disabled="submitLoading" :total="fmResult?.count"
			:page-size="fmResult?.pageSize" :pager-count="5" :hideOnSinglePage="true" @change="pageChange" />
	</view>
	<page-container :show="showDeatilPage" position="right" :round="true" @afterleave="showDeatilPage=false"
		custom-style="background-color: #f5f5f7;width:750rpx">
		<view class="page-wrap-container" style="width:750rpx;">
			<view style="margin-top:100px;padding: 14px;display: flex;flex-direction:row;justify-content: center;"
				v-if="active_fm!=null">
				<view style="background-color: #fff;border-radius: 14px;padding:24px 14px;max-width: 500px;flex:1">
					<rice-cell-group>
						<rice-cell icon="/static/icons/fm/time.png" :title-style="{'paddingLeft':'4px'}" center
							:title="i18n.global.t('finance.transaction_date')" :value="formatDate(active_fm?.ioeTime)"
							:clickable="false" />
						<rice-cell icon="/static/icons/fm/sztype.png" :title-style="{'paddingLeft':'4px'}" center
							:title="i18n.global.t('finance.voucher_Type')" :value="formatTypeName(active_fm?.type)"
							:clickable="false" />
						<rice-cell v-if=" active_fm?.billType=='income'" icon="/static/icons/fm/income.png"
							:title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.income')"
							:value="active_fm?.amount" :clickable="false" />
						<rice-cell v-if=" active_fm?.billType=='expenses'" icon="/static/icons/fm/expenses.png"
							:title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.expense')"
							:value="active_fm?.amount" :clickable="false" />
						<rice-cell icon="/static/icons/fm/mark.png" :title-style="{'paddingLeft':'4px'}" center
							:title="i18n.global.t('form.remark')" :value="active_fm?.mark" :clickable="false" />
					</rice-cell-group>
					<view style="margin-top:20px">
						<rice-row :gutter="8">
							<rice-col :span="10"></rice-col>
							<rice-col :span="6">
								<view>
									<rice-button type="primary" size="small" plain-fill :text="i18n.global.t('common.btn_txt_modify',[''])"
										@click="editFm(active_fm)"></rice-button>
								</view>
							</rice-col>
							<rice-col :span="6">
								<view>
									<rice-button type="error" size="small" plain-fill :text="i18n.global.t('common.btn_txt_delete')"
										@click="deleteFm(active_fm)"></rice-button>
								</view>
							</rice-col>
						</rice-row>
					</view>
				</view>
			</view>
		</view>
	</page-container>
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { dayuts } from '@/uni_modules/lime-dayuts';
	import { TIME, getMonthDateArray } from "@/static/utils/TIME";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { FMService } from "@/services/FMService";
	import { roomBean } from '@/bean/roomBean';
	import { FMBean, FMDataListResult, FMTypeConfigBean } from '@/bean/FMBean';
	import { state } from "@/store/store";
	import { fmState, setIncomeAndExpensesConfig } from "@/store/modules/fmStore.uts";
	import { userBean } from "@/bean/userBean";
	import i18n from '@/i18n/index.uts';
	import { comFunction } from "@/pages/index/ComFuc";
	import fmSearchComponent from "./components/fmSearchComponent/fmSearchComponent";
	import expensesInfoCardComponent from "./components/expensesInfoCardComponent/expensesInfoCardComponent";
	import incomeInfoCardComponent from "./components/incomeInfoCardComponent/incomeInfoCardComponent";
	import { SwipeActionsMenu, SwipeActionsItemClick, SwipeActionsItemOpen, SwipeActionsItemClose } from '@/uni_modules/rice-ui'

	let submitLoading = ref(true);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const user = computed<userBean>(() => {
		return state.user;
	});
	const permissionList = computed(() => {
		return state.permissionList;
	})
	const currentPage = ref(1);
	const roomTypeList = computed<Array<roomTypeBean> | null>(() => {
		return state.roomTypeList;
	});

	let _select_id = ref("income");
	let _search_key = ref("");
	const billType = ref("income");
	const keyword = ref("");
	const dateRange = ref<string[]>(getMonthDateArray());
	const columns = computed<Array<Array<PickerOption>>>(() => {
		let result : Array<Array<PickerOption>> = [[
			{ text: i18n.global.t('finance.income'), value: 'income' },
			{ text: i18n.global.t('finance.expense'), value: 'expense' }
		]];
		return result;
	});

	const incomeAndExpensesConfigList = computed<Array<FMTypeConfigBean>>(() => {
		return fmState.incomeAndExpensesConfig;
	});
	const getIncomeAndExpensesConfigList = async () => {
		const list = await FMService.getIncomeAndExpensesConfig();
		setIncomeAndExpensesConfig(list);
	}

	const fmResult = ref<FMDataListResult>({
		count: 0,
		pageNo: 1,
		pageSize: 20,
		fmList: []
	})
	const getFmList = async () => {
		submitLoading.value = true;
		try {
			const fmr = await FMService.getIncomeAndExpensesDateBySearch(hotel_id.value, billType.value, keyword.value, dateRange.value, fmResult.value.pageNo, fmResult.value.pageSize);
			fmResult.value = fmr as FMDataListResult;
			submitLoading.value = false;
		} catch (e) {
			submitLoading.value = false;
			uni.showToast({
				title: i18n.global.t("common.getData_fail", ['']),
				icon: "none"
			})
		}
	}
	const showDeatilPage = ref(false);
	const active_id = ref("");
	const active_fm = computed<FMBean | null>(() => {
		if (active_id.value == "") {
			return null;
		}
		const target = fmResult.value.fmList.find(item => item._id == active_id.value);
		if (target != null) {
			return target;
		}
		return null;
	});
	const dateChange = (range : string[]) => {
		dateRange.value = range;
		getFmList();
	}
	const searchInputChange = (k : string) => {
		keyword.value = k;
	}
	const selectFm = (bt : string) => {
		billType.value = bt;
		getFmList();
	}
	const pageChange = (pn : number) => {
		console.log(pn, fmResult.value);
		getFmList();
	}
	const formatDate = (timestamp : number | null) : string => {
		if (timestamp == null) {
			return "--";
		}
		return dayuts(new Date(timestamp)).format("YYYY-MM-DD");
	}
	const formatTypeName = (type : string | null) : string => {
		if (type == null) {
			return "--";
		}
		const target = incomeAndExpensesConfigList.value.find(item => item.name == type);
		if (target != null) {
			return target.text
		}
		return "--"
	}
	const swipeControlRef = ref<RiceSwipeActionsComponentPublicInstance | null>(null)
	const closeSwiper = () => {
		swipeControlRef.value!.closeAll!();
	}
	const addFm = async () => {
		if (!permissionList.value.includes("FM_CREATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.$once("refrushfmList", () => {
			getFmList();
		})
		uni.navigateTo({
			url: `/pages/financialManagement/inExManage/createIncomeAndExpense/createIncomeAndExpense?billType=${billType.value}`
		});
	}
	const deleteFm = async (fm : FMBean | null) => {
		if (fm == null) return;
		if (submitLoading.value == true) return;
		if (!permissionList.value.includes("ROOMTYPE_DELETE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),
			beforeClose: async () : Promise<boolean> => {
				try {
					const flag = await FMService.deleteFm(fm._id);
					if (flag) {
						getFmList();
						showDeatilPage.value = false;
						hideDialog();
						return true;
					} else {
						return false;
					}
				} catch (error:Error) {
					return false;
				}
			},
			confirm: () => {},
			cancel: () => {
				hideDialog();
			}
		});
	}
	const editFm = async (fm : FMBean | null) => {
		if (fm == null) return;
		if (!permissionList.value.includes("ROOMTYPE_UPDATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.$once("refrushfmList", () => {
			getFmList();
		});
		uni.navigateTo({
			url: `/pages/financialManagement/inExManage/createIncomeAndExpense/createIncomeAndExpense?pageType=1&fm=${encodeURIComponent(JSON.stringify(fm))}`
		})
	}
	const viewFm = (fm : FMBean) => {
		active_id.value = fm._id;
		showDeatilPage.value = true;
	}
	const init = async () => {
		await getIncomeAndExpensesConfigList();
		getFmList();
	}
	onPageShow(() => {})
	init();
</script>

<style>
/* 顶部搜索外层容器 */
.search-wrap-root {
	padding: 18px;
}
/* 搜索卡片容器 */
.search-card-box {
	background-color: #fff;
	border-radius: 8px;
	padding: 16px;
}
/* 卡片通用行 */
.search-card-row {
	margin-bottom: 15px;
}
/* 最后一行无底部间距 */
.search-row-last {
	margin-bottom: 0;
}
/* 标题行布局 */
.title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* 标题文字 */
.title-text {
	padding-right: 8px;
	font-size: 18px;
	font-weight: 700;
}
/* 下拉筛选行 */
.select-row {
}

/* 导航栏右侧新增按钮 */
.navbar-btn-root {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 12px 15px;
	border-radius: 8px;
}
.navbar-text {
	color: #007aff;
	font-size: 15px;
	padding-left: 4px;
}

/* 侧滑菜单外层 */
.swipe-menu-container {
	display: flex;
	flex-direction: row;
	height: 100%;
}
/* 侧滑每个按钮项 */
.menu-item-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 70px;
	height: 100%;
}
.menu-detail {
	background-color: #007aff;
}
.menu-edit {
	background-color: #ff7d00;
}
.menu-del {
	background-color: #f53f3f;
}
/* 菜单文字 */
.menu-item-text {
	color: #fff;
	font-size: 12px;
	margin-top: 4px;
}
/* 列表左侧图标 */
.cell-left-icon {
}
/* 右侧弹窗外层 */
.page-wrap-container {
}
</style>