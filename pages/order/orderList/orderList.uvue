<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>

				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{ i18n.global.t('order.orderList') }}</text>
			</view>
		</template>
		<template #right>
			<view class="navbar-btn" @click="addOrder">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>
				<text class="navbar-btn-txt">{{ i18n.global.t('order.title_order') }}</text>
			</view>
		</template>
	</rice-navbar>
	
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<view class="search-area-root">
			<view class="search-card">
				<view class="search-card-item title-row">
					<text class="title-txt">{{ i18n.global.t('order.orderFilter') }}</text>
					<l-tag variant="light">{{ i18n.global.t('common.totalCount',[orderResult.count]) }}</l-tag>
				</view>
				<view class="search-card-item select-row">
					<orderSearchComponent :columns="columns" :initDateRange="dateRange"
						@searchInputChange="searchInputChange" @selectAction="selectStatus" @dateChange="dateChange"
						@searchAction="getOrderList" :placeholder="i18n.global.t('order.searchPlaceholder')"></orderSearchComponent>
				</view>
				<view class="search-card-item empty-row"></view>
			</view>

		</view>
		<view class="order-list-root">
			<view class="order-card-item" v-for="order of orderResult.orderList">
				<view class="order-card">
					<view class="tag-wrap">
						<view> 
						<rice-tag v-if="order.orderStatus==1" type="primary" :text="i18n.global.t('order.statusCheckInPending')" />
						<rice-tag v-if="order.orderStatus==5" type="success" :text="i18n.global.t('order.statusCompleted')" />
						<rice-tag v-if="order.orderStatus==10" type="error" :text="i18n.global.t('order.statusCancelled')" />
						</view>
					
					</view>
					
					<view class="card-content-wrap">
						<view class="content-row">
							<view class="label-flex">
								<image src="/static/icons/hotelcustomer.png" style="width: 13px;height: 13px;"></image>
								<text class="label-text">{{ i18n.global.t('order.guest') }}：</text>
							</view>
							<text class="value-text">{{order.userName}}</text>
						</view>
						<view class="content-row">
							<view class="label-flex">
								<image src="/static/icons/fm/time.png" style="width: 16px;height: 16px;"></image>
								<text class="label-text">{{ i18n.global.t('order.checkInTime') }}：</text>
							</view>
							<text class="value-text">{{formatDate(order.checkInStartDateTimeStamp)}}</text>
						</view>
						<view class="content-row">
							<view class="label-flex">
								<image src="/static/icons/fm/time.png" style="width: 16px;height: 16px;"></image>
								<text class="label-text">{{ i18n.global.t('order.checkOutTime') }}：</text>
							</view>
							<text class="value-text">{{formatDate(order.checkInEndDateTimeStamp)}}</text>
						</view>
						<view class="content-row">
							<view class="label-flex">
								<image src="/static/icons/roomReserve.png" style="width: 16px;height: 16px;"></image>
								<text class="label-text">{{i18n.global.t("order.room")}}：</text>
							</view>
							<view class="flex-wrap-val" style="display: flex;flex-direction: row;align-items: center;flex: 1;flex-wrap: wrap;justify-content: flex-end;">
								<text v-for="item of formatRoomList(order.reservedRoomList)" style="padding:0 4px">{{item}}</text> 
							</view>
						</view>
						<view class="content-row no-bottom">
							<view class="label-flex">
								<image src="/static/icons/fm/mark.png" style="width: 16px;height: 16px;"></image>
								<text class="label-text">{{ i18n.global.t('order.remark') }}：</text>
							</view>
							<text class="value-text">
								{{order.mark}}
							</text>
						</view> 
						<view class="content-row no-bottom">
							<view class="label-flex">
								<image src="/static/icons/fm/income.png" style="width: 16px;height: 16px;"></image>
								<text class="label-text">{{ i18n.global.t('order.roomPrice') }}：</text>
							</view>
							<text class="price-text" style="color:#047857;font-weight: 700;">
								￥{{order.totalAmount}}
							</text>
						</view> 
					</view>

					<view class="btn-control-wrap">
						<view>
							<xt-control @del="deleteOrder(order)" @edit="editOrder(order)" :show-view="false" :show-edit="false" :show-delete="order.orderStatus!=10"></xt-control>
						</view>
					</view>
				</view>
			</view>
		</view>
		<view v-if="submitLoading" style="margin-top:68px;display: flex;flex-direction: row;justify-content: center;">
			<rice-loading color="#787878" :text="i18n.global.t('common.loading')" />
		</view>
		<l-empty :description="i18n.global.t('common.noData',[''])" v-if="!submitLoading&&orderResult.orderList.length<1" />
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<view style="padding:15px 5px;background-color: #fff;display: flex;flex-direction: row;justify-content: center;"  v-if="!submitLoading&&orderResult!=null&&orderResult.count>orderResult.pageSize">
		<l-pagination v-model="orderResult.pageNo" :disabled="submitLoading" :total="orderResult?.count"
			:page-size="orderResult?.pageSize" :pager-count="5" :hideOnSinglePage="true" @change="pageChange" />
	</view>
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { dayuts } from '@/uni_modules/lime-dayuts';
	import { TIME, getMonthDateArray } from "@/static/utils/TIME";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { OrderService } from "@/services/OrderService";
	import { orderBean,OrderRoomTypeBean, OrderDataListResult } from '@/bean/orderBean.uts';
	import { state } from "@/store/store";
	import { fmState } from "@/store/modules/fmStore.uts";
	import { comFunction } from "@/pages/index/ComFuc";
	import orderSearchComponent from "./components/orderSearchComponent/orderSearchComponent";
	import { roomBean } from "@/bean/roomBean";
	import {userBean} from "@/bean/userBean";
	import {getGatherEvent } from "@/store/modules/orderStore";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "app"
	})
	let submitLoading = ref(false);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});

	const user = computed<userBean>(() => {
		return state.user;
	});
	const permissionList = computed(() => {
		return state.permissionList;
	})
	const currentPage = ref(1);
	const roomTypeList = computed<Array<roomTypeBean> | null>(() => {
		return state.roomTypeList;
	});
	const roomList = computed<Array<roomBean>>(() => {
		return state.roomList;
	});
	let _select_id = ref("income");
	let _search_key = ref("");
	const orderStatus = ref<string | number>("all");
	const keyword = ref("");
	const dateRange = ref<string[]>(getMonthDateArray());
	const columns = computed<Array<Array<PickerOption>>>(() => {
		let result : Array<Array<PickerOption>> = [[
				{ text: i18n.global.t('order.statusAll'), value: "all" },
			      { text: i18n.global.t('order.statusCheckInPending'), value: 1 },
			      { text: i18n.global.t('order.statusCompleted'), value: 5 },
			      { text: i18n.global.t('order.statusCancelled'), value: 10 },
		]];
		return result;
	});


	const orderResult = ref<OrderDataListResult>({
		count: 0,
		pageNo: 1,
		pageSize: 20,
		orderList: []
	})
	const getOrderList = async () => {
		submitLoading.value = true;
		const fmr = await OrderService.getOrderListBySearch(hotel_id.value, dateRange.value, orderStatus.value, keyword.value, orderResult.value.pageNo, orderResult.value.pageSize);
		orderResult.value = fmr as OrderDataListResult;
		submitLoading.value = false;
	}
	const dateChange = (range : string[]) => {
		dateRange.value = range;
		getOrderList();

	}
	const searchInputChange = (k : string) => {
		keyword.value = k;
	}
	const selectStatus = (bt : string | number) => {
		orderStatus.value = bt;
		getOrderList();
	}
	const pageChange = (pn : number) => {
		getOrderList();
	}
	const formatDate = (timestamp : number) => {
		return dayuts(new Date(timestamp)).format("YYYY-MM-DD");
	}
	const formatRoomName = (room_id : string):string => {
			let val="--";
		if (roomTypeList.value == null) {
			return val;
		}
		roomTypeList.value.forEach(roomtype=>{
			let list = roomtype.roomList as Array<roomBean>;
			list.forEach(room=>{
				if(room._id ==room_id){
					val=room.room_name;
					return;
				}
				
			})
		})	
		return val;
	}
	const formatRoomList = (list : Array<string>) : Array<string> => {
		let result : Array<string> = [];
		list.forEach(room_id => {
			let room = roomList.value.find(item => item._id == room_id);
			if(room==null){
				result.push("-");
				
			}else{
				result.push(room.room_name);
			}
			
		})
	
		return result;
	}
	const addOrder = async () => {
		if (!permissionList.value.includes(
			"FM_CREATE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.$once("refrushOrderList", ()=>{
			getOrderList();
		})
		uni.navigateTo({
			url: `/pages/order/createOrder/createOrder`
		});
	}
	const deleteOrder = async (order : orderBean) => {
		if (submitLoading.value == true) {
			return;
		}
		if (!permissionList.value.includes(
			"ORDER_DELETE"
		)) {
		showDialog({
						title: i18n.global.t('permission.noPermission'),
						message: i18n.global.t('permission.contactAdmin'),
						showCancelButton: false,
						confirm: () => {
							hideDialog();
						}
					})
			return;
		}
		showDialog({
			title: i18n.global.t('order.confirmDeleteOrder'),
			message: i18n.global.t('order.deleteOrderTip')+"?",
			beforeClose: async () : Promise<boolean> => {
				await OrderService.deleteOrder(order._id);				
				await getOrderList();
				getGatherEvent(hotel_id.value);
				hideDialog();
				return true;

			},
			confirm: () => {
			}, cancel: () => {
				hideDialog();
			}

		});
	}
	const editOrder = async (order:orderBean) => {
		if (!permissionList.value.includes(
			"ROOMTYPE_UPDATE"
		)) {
		showDialog({
								title: i18n.global.t('permission.noPermission'),
								message: i18n.global.t('permission.contactAdmin'),
								showCancelButton: false,
								confirm: () => {
									hideDialog();
								}
							})
			return;
		}
	}
	const init = () => {
		getOrderList();
	}
	onPageShow(() => {
	})
	defineExpose({
	});
	init();
</script>

<style>
/* 顶部搜索区域 */
.search-area-root {
	padding: 18px;
}
.search-card {
	background-color: #fff;
	border-radius: 8px;
	padding: 16px;
}
.search-card-item {
	margin-bottom: 15px;
}
.empty-row {
	margin-bottom: 0;
}
.title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}
.title-txt {
	padding-right: 8px;
	font-size: 18px;
	font-weight: 700;
	color:#999;
}
.select-row {
}

/* 订单列表外层容器 */
.order-list-root {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.order-card-item {
	min-width: 320px;
	padding: 7.5px 15px;
	flex: 1;
}
.order-card {
	background-color: #fff;
	border-radius: 12px;
	position: relative;
}
.tag-wrap {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	padding: 10px 10px 0 0;
}

/* 卡片内容区域 */
.card-content-wrap {
	padding: 24px;
}
.content-row {
	margin-top: 15px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.no-bottom {
	margin-top: 0;
}
.label-flex {
	display: flex;
	flex-direction: row;
	align-items: center;
}
.label-text {
	color: #1f2937;
	font-size: 13px;
	padding-left: 8px;
}
.value-text {
	color: #1f2937;
	font-size: 13px;
}
.flex-wrap-val {
	color: #1f2937;
	font-size: 13px;
}
.price-text {
	font-size: 13px;
}

/* 底部操作按钮区域 */
.btn-control-wrap {
	padding:0 12px 12px 0;
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	align-items: center;
}

.navbar-btn{
	  display: flex;
	  flex-direction: row;
	  align-items: center;
	  justify-content: center;
	  padding: 12px 15px;
	  border-radius: 8px;
  }
   .navbar-btn-txt {
  	color: #007aff;
  	font-size: 15px;
  	padding-left: 4px;
  }

</style>