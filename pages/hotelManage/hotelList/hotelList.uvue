<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>
				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("hotel.hotel_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="nav-add-hotel-btn" @click="addHotel">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>
				<text class="nav-btn-text">{{i18n.global.t("common.btn_txt_create",[i18n.global.t("hotel.title")])}}</text>
			</view>
		</template>
	</rice-navbar>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1" v-if="!submitLoading&&hotelList.length>0">
	<!-- #endif -->
		<view class="hotel-list-wrap">
			<view class="hotel-card-item" v-for="hotel of hotelList">
				<view class="hotel-card-box">
					<view class="card-img-block">
						<image :src="hotel.firstImages" v-if="hotel.firstImages!=''" style="height: 100%;width: 100%;"
							mode="aspectFill">
						</image>
					
							<image
								src="/static/images/noimg.png" 
								v-if="hotel?.firstImages==''"
								style="height: 40%;width: 40%;" 
								mode="aspectFit"
							></image>
						
					</view>
					<view class="card-title-wrap">
						<view class="card-title-inner">
							<view class="card-name-row">
								<text class="hotel-name-text">{{hotel.hotelName}}</text>
							</view>
							<view class="desc-row">
								<image src="/static/icons/position_black.png"
									style="width:18px;height:18px;margin-right: 4px;"></image>
								<text class="desc-text">{{(hotel.hotelAddress as string | null) != null ? hotel.hotelAddress : '--'}}</text>
							</view>
							<view class="desc-row extra-top">
								<image src="/static/icons/administrator.png"
									style="width:18px;height:18px;margin-right: 4px;"></image>
								<text class="desc-text">{{i18n.global.t("hotel.storekeeper")}}：{{belong(hotel.belong??"")}}</text>
							</view>
							<view class="desc-row">
								<image src="/static/icons/role.png" style="width:18px;height:18px;margin-right: 4px;">
								</image>
								<text class="desc-text">{{i18n.global.t("hotel.role")}}：{{roleFormat(hotel.curRole ?? '')}}</text>
							</view>
						</view>
						<view class="status-tag-wrap">
							<text class="status-text">{{i18n.global.t('hotel.normal_operation')}}</text>
						</view>
					</view>
					<view class="card-operate-wrap">
						<xt-control :showEdit="hotel.curRole == 'administrator'"
							:showDelete="hotel.curRole == 'administrator'" @del="deleteHotel(hotel)"
							@view="viewDetail(hotel)" @edit="editHotel(hotel)"></xt-control>
					</view>
				</view>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<l-empty :description="i18n.global.t('common.noData',[''])" v-if="!submitLoading&&hotelList.length<1" />
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui"
	import { state } from "@/store/store";
	import { emergency_phone_number } from "@/static/utils/telphone_transform.uts";
	import { comFunction } from "@/pages/index/ComFuc.uts";
	import { HotelService } from "@/services/HotelService.uts";
	import { hotelBean } from "@/bean/hotelBean.uts"
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated"
	})
	let submitLoading = ref(false);
	const hotelList = computed<Array<hotelBean>>(() => {
		return state.hotelList;
	});
	const topImg = (imgUrl : string | null) : string => {
		if (imgUrl == null || imgUrl == '') {
			return '/static/images/noimg.png';
		}
		return imgUrl;
	};
	const belong = (phone : string) : string => {
		return emergency_phone_number(phone)
	}
	const roleFormat = (val : string) : string => {
		const p : Map<string, string> = new Map([
			["administrator", "超级管理员"],
			["manager", "管理员"],
			["normal", "员工"]
		]);
		return p.get(val) ?? val;
	}
	const editHotel = (hotel_item : hotelBean) => {
		if (hotel_item.curRole != "administrator") {
			return;
		}
		uni.navigateTo({
			url: `/pages/hotelManage/createHotel/createHotel?pageType=1&&hotel_item=${encodeURIComponent(JSON.stringify(hotel_item))}`,
		});
	}
	const addHotel = () => {
		console.log("addhotel");
		uni.navigateTo({
			url: "/pages/hotelManage/createHotel/createHotel"
		});
	}
	const deleteHotel = async (targetObj : hotelBean) => {
		console.log("targetObj", targetObj);
		if (targetObj.curRole != "administrator") {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),
			beforeClose: async () : Promise<boolean> => {
				try {
					await HotelService.deleteHotel(targetObj._id as string);
					await comFunction.init();
					hideDialog();
					uni.showToast({
						title: "删除成功",
						icon: "none"
					});
					return true;
				} catch (e) {
					uni.showToast({
						title: "系统异常",
						icon: "none"
					});
					return false;
				}
			},
			confirm: () => {},
			cancel: () => {
				hideDialog();
			}
		});
	}
	const viewDetail = (hotel_item : hotelBean) => {
		uni.navigateTo({
			url: `/pages/hotelManage/createHotel/createHotel?pageType=2&&hotel_item=${encodeURIComponent(JSON.stringify(hotel_item))}`,
		});
	}
</script>

<style>
/* 导航新增酒店按钮 */
.nav-add-hotel-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 12px 15px;
	border-radius: 8px;
}
.nav-btn-text {
	color: #007aff;
	font-size: 15px;
	padding-left: 4px;
}

/* 酒店列表外层容器 */
.hotel-list-wrap {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
/* 单个酒店卡片容器 */
.hotel-card-item {
	min-width: 320px;
	padding: 15px;
	flex: 1;
}
/* 卡片主体盒子 */
.hotel-card-box {
	background-color: #fff;
	border-radius: 12px;
}
/* 图片区域 */
.card-img-block {
	height: 350rpx;
	max-height: 200px;
	background-color: #eee;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
/* 标题与状态外层 */
.card-title-wrap {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 15px;
}
/* 文字信息内部容器 */
.card-title-inner {
}
/* 酒店名称行 */
.card-name-row {
}
.hotel-name-text {
	color: rgb(30, 30, 30);
	font-weight: 700;
	font-size: 20px;
}
/* 描述信息通用行 */
.desc-row {
	margin-top: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* 带顶部外边距的描述行 */
.extra-top {
	margin-top: 15px;
}
/* 描述文字 */
.desc-text {
	color: rgb(144, 147, 153);
	font-size: 14px;
	padding-left: 4px;
}
/* 状态标签容器 */
.status-tag-wrap {
}
.status-text {
	background-color: rgba(255, 152, 0, 0.1);
	color: rgb(255, 152, 0);
	font-size: 14px;
	padding: 8px;
	border-radius: 4px;
}
/* 底部操作栏容器 */
.card-operate-wrap {
	display: flex;
	flex-direction: row;
	padding: 15px;
}
</style>