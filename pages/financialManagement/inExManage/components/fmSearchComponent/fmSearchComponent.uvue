<template>
	<view class="fm-search-root">
		<view class="search-select-item">
			<view style="display: flex;flex-direction: row;align-items: center;">
				<view style="margin-right: 8px">
					<rice-button :type="billType=='income'?'primary':'info'" size="small"
						:text="i18n.global.t('finance.income')" @click="checkBillType('income')"></rice-button>
				</view>
				<view>
					<rice-button size="small" :type="billType=='expenses'?'primary':'info'"
						:text="i18n.global.t('finance.expense')" @click="checkBillType('expenses')"></rice-button>
				</view>
			</view>
		</view>
		<view class="search-select-item">
			<view class="date-select-box">
				<view class="date-select-content" @click="showCalendarEvent">
					<text class="date-select-txt">{{dateRange.join(" ~ ") }}</text>
					<image src="/static/icons/calendar.png" style="width: 20px;height:20px"></image>
				</view>
			</view>
		</view>
		<view class="search-select-item">
			<view class="date-select-box" style="padding-right: 8px;">
				<rice-search v-model="keystr" input-color="#fff" :clearable="false" :placeholder="placeholder"
					:custom-style="{'padding':0}" @search="searchEvent" @clickLeftIcon="searchEvent"
					@input="searchInputChange" @clickAction="searchEvent" show-action left-icon=""
					action-color="#007aff" :action-text="i18n.global.t('common.btn_txt_search')" />
			</view>
		</view>
		<rice-calendar v-model:show="showCalendar" mode="range" :date="dateRange"
			@confirm="rangeConfirm"></rice-calendar>
	</view>
</template>

<script setup>
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { dayuts } from '@/uni_modules/lime-dayuts';
	import { TIME, MOONTH_START_END_TIMESTAMP, getMonthDateArray } from "@/static/utils/TIME";
	import i18n from '@/i18n/index.uts';
	const emit = defineEmits(['selectAction', "searchAction", "searchInputChange", "dateChange"]);
	const props = defineProps({
		initDateRange: {
			type: Array<string>,
			default: []
		},
		placeholder: {
			type: String,
			default: "请输入关键字"
		}
	});
	const columns = ref<PickerOption[][]>([
		[
			{ text: i18n.global.t('finance.income'), value: 'income' },
			{ text: i18n.global.t('finance.expense'), value: 'expense' }
		]
	])
	const attrs = useAttrs();
	let showPicker = ref(false);
	let showCalendar = ref(false);
	const billType = ref("income");
	let text_val = ref("请选择");
	let keystr = ref("");
	text_val.value = columns.value[0][0]['text'] as string;

	const dateRange = ref<string[]>(props.initDateRange);
	const checkBillType = (id : string) => {
		billType.value = id;
		emit("selectAction", id);
	}
	const showSelect = () => {
		showPicker.value = !showPicker.value;
	}
	const showCalendarEvent = () => {
		showCalendar.value = !showCalendar.value;
	}
	const searchEvent = () => {
		emit("searchAction", billType.value, dateRange.value, keystr.value);
	}
	const searchInputChange = (value : string) => {
		emit("searchInputChange", value);
	}
	const rangeConfirm = (e : string[]) => {
		console.log('rangeConfirm', e)
		emit("dateChange", e);
		//dateRange.value = e;
	}
</script>

<style>
/* 外层筛选容器 */
.fm-search-root {
	
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
}
/* 每一列筛选项 */
.search-select-item {
	margin-bottom: 12px;
	min-width: 290px;
	flex: 1;
}
/* 日期选择外框 */
.date-select-box {
	position: relative;
	border: 1px solid #dcdfe6;
	box-sizing: border-box;
	overflow: visible;
	border-radius: 4px;
}
/* 日期选择内部行 */
.date-select-content {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	height: 36px;
	padding: 0 8px;
	overflow: visible;
}
/* 日期文字 */
.date-select-txt {
	line-height: 36px;
}
/* 废弃弹窗面板样式，页面未使用直接删除 */
</style>