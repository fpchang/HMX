<template>
	<view class="page">
		<view class="card">
			<view class="title"><text class="txt">注册账号</text></view>
			<verifyEmailComponent @setEmailEvent="setEmailEvent"></verifyEmailComponent>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { FormRules, FormValidateErrors } from "@/uni_modules/rice-ui";
	import { AccountService } from "@/services/AccountService";
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import verifyAccountComponent from "./components/verifyAccountComponent.uvue";
	import verifyEmailComponent from "./components/verifyEmailComponent.uvue";
	const submitLoading = ref(false);
	type userType = {
		account : string,
		email : string,
		emailCode : string,
		password : string,
		confirmPassword : string,
		emailCodeTk : string
	}
	const userForm = ref<userType>({
		account: '',
		email: "",
		emailCode: "",
		password: '',
		confirmPassword: '',
		emailCodeTk: ""
	});

	const userFormRef = ref<RiceFormComponentPublicInstance | null>(null);
	const codeDisabled = ref(false);
	const setEmailEvent = (email : string) => {
		userForm.value.email = email;
	}
	
	// 注册提交
	const handleRegister = async () => {
		if (submitLoading.value == true) {
			return;
		}
		const result = await userFormRef.value!.validate();
		console.log("result", result);
		//校验成功
		if (result != true) {
			console.log("校验失败");
			return;
		}
		console.log("success")
		const userJSON = {
			account: userForm.value.account,
			email: userForm.value.email,
			password: userForm.value.password,
			emailCode: userForm.value.emailCode,
			confirmPassword: userForm.value.confirmPassword,
			emailCodeTk: userForm.value.emailCodeTk
		} as UTSJSONObject;
		try {
			submitLoading.value = true;
			const flag = await AccountService.register(userJSON);
			if (flag) {
				uni.setStorageSync("account", userForm.value.account);
				console.log("99999999999999", flag)
				uni.navigateBack();
				uni.showToast({
					title: "注册成功",
					icon: "none"
				});
			}
			submitLoading.value = false;

		} catch (err) {
			//throw new Error(error.message as string);
			console.log("eeeeeeeeeeeeeeeeeeeeeee");
			submitLoading.value = false;
			showDialog({
				title: '注册失败',
				message: err.message as string,
				showCancelButton: false,
				confirm: () => {
					submitLoading.value = false;
				}
			})
		}
	}
	//AccountService.upp();
</script>
<style scoped lang="scss">
	.page {
		flex: 1;
		// background: linear-gradient(180deg, #f2f5f9 0%, #e6ebf5 100%);
		padding: 0 16px;
		box-sizing: border-box;
	}

	.card {
		background: #ffffff;
		padding-top: 60px;
		border-radius: 20px;
		padding: 40px 20px;
		// box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
	}

	.title {

		text-align: center;
		margin-bottom: 40px;

		.txt {
			font-size: 32px;
			font-weight: 600;
			color: #1d1d1f;
		}
	}

	.input-box {
		margin-bottom: 20px;
		border-bottom: 0.5px solid #e5e7eb;
		background-color: #fff;
		border-radius: 25px;
	}

	.input {
		height: 50px;
		padding: 0 16px;
		font-size: 16px;
		color: #1d1d1f;
	}

	.ph {
		color: #8e8e93;
	}

	.btn-register {
		margin-top: 35px;
		width: 100%;
		height: 50px;
		line-height: 50px;
		background: #007aff;
		color: #fff;
		border-radius: 25px;
		font-size: 17px;
		font-weight: 500;
		border: none;
	}

	.input-row {

		width: 100%;
		height: 100%;
		display: flex;
		flex: 1;
		flex-direction: row;
		justify-content: space-between;

		overflow: hidden;
	}

	.btn-code {
		font-size: 14px;
		color: #007aff;
		background: #fff;
		border: none;
		outline: none;
		padding: 0 8px;
		margin: 0 4px;
	}

	.btn-code[disabled] {
		color: #8e8e93;
	}
</style>