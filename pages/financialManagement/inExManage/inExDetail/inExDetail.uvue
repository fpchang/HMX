		const fm=ref<FMBean | null>(null);
		const incomeAndExpensesConfigList = ref<Array<FMTypeConfigBean>>([]);
		const getIncomeAndExpensesConfigList = async () => {
			const list = await FMService.getIncomeAndExpensesConfig();
			incomeAndExpensesConfigList.value = list;
		}
		
		const formatDate = (timestamp : number) : string => {
			return dayuts(new Date(timestamp)).format("YYYY-MM-DD");
		}
		const formatTypeName = (type : string) : string => {
			const target = incomeAndExpensesConfigList.value.find(item => item.name == type);
			if (target != null) {
				return target.text
			}
			return "--"
		}
		const init = async () => {
			//let d:MOONTH_START_END_TIMESTAMP=TIME.getTodayStartTimeAndEndTime(new Date());
			await getIncomeAndExpensesConfigList();
		
		}
