<template>
	<view class="room-card-root-wrap" v-if="roomTypeList!=null">
		<view class="single-room-card-item" v-for="(roomType,index) of roomTypeList">
			<view class="room-card-box">
				<view class="card-image-block">
					<image v-if="roomType.firstImages!=''" :src="roomType.firstImages" style="height: 100%;width: 100%;" mode="aspectFill">
					</image>
					<image  v-if="roomType.firstImages==''"  src="/static/images/nono-img.png" style="height: 80%;width: 80%;" mode="aspectFit">
					</image>
				</view>
				<view class="card-info-row">
					<view class="card-text-container">
						<view class="card-name-price-row">
							<text class="room-name-text">{{roomType.name}}</text>
							<text class="room-price-text">¥{{roomType.priceBase}}</text>
						</view>
						<view class="tag-group-row" style="justify-content: flex-start;margin-bottom: 16px;">
							<view>
								<rice-tag :text="`${roomType.area}㎡`" text-color="#4e5969" color="#f2f3f5" :round="true" />
							</view>
							<view style="margin-left: 8px;" v-for="it of roomType.bedList">
								<rice-tag :text="`${it['count']}张${it['name']}床`" text-color="#4e5969" color="#f2f3f5" text-size="12px" :round="true" />
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { state } from "@/store/store";
	import { emergency_phone_number } from "@/static/utils/telphone_transform.uts";
	import { comFunction } from "@/pages/index/ComFuc.uts";
	import { roomTypeService } from "@/services/roomTypeService";
	import {roomTypeBean} from "@/bean/roomTypeBean.uts";
	import { hotelBean } from "@/bean/hotelBean";
	defineOptions({
		styleIsolation: "isolated"
	})
	let submitLoading = ref(false);
	const props = defineProps({
		hotel_id:{
			type:String,
			default:""
		}
	})
	const roomTypeList= ref<Array<roomTypeBean> | null>(null);
	const getRoomTypeList = async ()=>{
		if (props.hotel_id == null || props.hotel_id == "") {
			return ;
		}
		const list = await roomTypeService.getRoomTypeList(props.hotel_id);
		console.log("房型列表", list);
		roomTypeList.value=list;		
	}
	const topImg = (imgUrl : string) : string => {
		if (imgUrl == '') {
			return '/static/images/nono-img.png';
		}
		return imgUrl;
	};
	const belong = (phone : string) : string => {
		return emergency_phone_number(phone)
	}
	const roleFormat = (val : string) : string => {
		const p : Map<string, string> = new Map([
			["a3dministrator", "超级管理员"],
			["manager", "管理员"],
			["normal", "员工"]
		]);
		return p.get(val) ?? val;
	}
	let showControl_id = ref("");
	const getRoomTypeId = (roomType: UTSJSONObject): string => {
		const idObj = roomType["_id"] as UTSJSONObject;
		return idObj["_value"] as string;
	}
	const viewDetail = (roomType : roomTypeBean) => {
		uni.navigateTo({
			url: `/pages/hotelManage/createRoomType/createRoomType?pageType=2&roomType_id=${roomType._id}`,
		});
	}
	let scrollTop_val = ref(0);
	const scrollPage = (event : UniScrollEvent) => {
		let { scrollTop } = event.detail;
		scrollTop_val.value = scrollTop
	}
	getRoomTypeList();
</script>

<style>
/* 房型列表最外层容器 */
.room-card-root-wrap {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
/* 单个房型卡片外层项 */
.single-room-card-item {
	min-width: 320px;
	padding: 15px;
	flex: 1;
}
/* 房型卡片主体盒子 */
.room-card-box {
	background-color: #fff;
	border-radius: 12px;
}
/* 卡片图片区域 */
.card-image-block {
	height: 350rpx;
	max-height: 200px;
	background-color: #eee;
	display: flex;
	align-items: center;
	justify-content: center;
}
/* 卡片文字信息整行容器 */
.card-info-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 15px;
}
/* 文字内容容器 */
.card-text-container {
	flex: 1;
}
/* 房型名称+价格行 */
.card-name-price-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12px;
}
/* 房型名称文字 */
.room-name-text {
	color: #1d2129;
	font-weight: 700;
	font-size: 18px;
}
/* 房型价格文字 */
.room-price-text {
	color: #165dff;
	font-size: 20px;
	font-weight: 700;
}
/* 标签组容器 */
.tag-group-row {
	margin-top: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
}
</style>