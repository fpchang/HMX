<template>
	<rice-navbar :fixed="false" title="" v-if="hotel_id!=''">
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<!-- s -->

				<image src="/static/icons/tab-menu-blue.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{ i18n.global.t('tab.function') }}
				</text>
			</view>
		</template>

	</rice-navbar>
	<scroll-view style="flex: 1;" v-if="hotel_id!=''" :show-scrollbar="false">
		<view class="homemenu">
			<view class="card" v-for="item in menuList">
				<!-- 替换 class 为 card-title，消除层级依赖 -->
				<view class="card-title">
					<image :src="item.title_icon" class="icon-stye123"></image>
					<text class="txt" :style="{'color':item.title_color}">{{item.title}}</text>
				</view>
				<view v-if=" i18n.global.locale.value == 'zh-CN'">
					<!-- <rice-grid :column-num="columnNum" :border="false">
						<rice-grid-item v-for="it in item.menu_item_list" :key="it.label" :icon="it.icon"
							:text="it.label" :to="it.url" />
					</rice-grid> -->
					<!-- <l-space :wrap="true" :size="14">
						<view v-for="it in item.menu_item_list" :key="it.label"
							style=" background:green;">
						
								<view class="item-content">
									<view class="groupIcon">
										<image :src="it.icon" class="icon-style" mode="aspectFit"></image>
									</view>
									<view>
										<text class="label">{{it.label}}</text>
									</view>
								</view>

							
						</view>
						
					</l-space> -->
					<view class="item-container" :style="cssVars">
						<view class="item" v-for="it in item.menu_item_list" :key="it.label">
						
								<view class="item-content" @click="navEvent(it.url)">
									<view class="groupIcon">
										<image :src="it.icon" class="icon-style" mode="aspectFit"></image>
									</view>
									<view>
										<text class="label">{{it.label}}</text>
									</view>
								</view>
						
							
						</view>
							<view class="item fill"  v-for="it in 10" ></view>
					</view>
					
				</view>

				<rice-cell-group v-if=" i18n.global.locale.value != 'zh-CN'">

					<rice-cell center size="medium" :title="it.label" v-for="it in item.menu_item_list" arrow
						:url="it.url" :border="false" :clickable="false">
						<template #leftIcon>
							<view style="padding-right: 8px;">
								<image :src="it.icon" style="width: 40px;height:40px;" mode="aspectFit"></image>
							</view>

						</template>
					</rice-cell>
				</rice-cell-group>
			</view>
		</view>
		<view style="height:70px"></view>
	</scroll-view>
	<view style="margin-top: 80px;" v-if="hotel_id==''">
		<l-empty :description="i18n.global.t('common.noData',[''])" />
	</view>
</template>
<script setup>
	import { state } from "@/store/store";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { roomBean } from '@/bean/roomBean';
	import { hotelBean } from "@/bean/hotelBean";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated" // 默认隔离；外部覆盖改为 app-and-page
	})
	type menu = {
		icon : string,
		label : string,
		bgColor : string,
		url : string
	}

	type MenuItem = {
		title : string,
		title_icon : string,
		title_color : string,
		menu_item_list : Array<menu>
	}
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const hotel = computed(() => {
		return state.hotel;
	});
	const hotelList = computed(() => {
		return state.hotelList;
	});
	const menuList = computed<Array<MenuItem>>(() => {
		return [
			{
				title: i18n.global.t("function.title_set"),
				title_icon: "/static/icons/homemenu/hotel-anage.png",
				title_color: "rgb(30,30,30)",
				menu_item_list: [{
					icon: "/static/icons/homemenu/v2/room-type.png",
					label: i18n.global.t("function.btn_txt_room_type"),
					bgColor: "rgba(22, 93, 255, 0.1)",
					url: "/pages/hotelManage/roomTypeList/roomTypeList"
				},
				{
					icon: "/static/icons/homemenu/v2/room.png",
					label: i18n.global.t("function.btn_txt_room"),
					bgColor: "rgba(22, 93, 255, 0.1)",
					url: "/pages/hotelManage/roomList/roomList"
				},
				{
					icon: "/static/icons/homemenu/v2/employee.png",
					label: i18n.global.t("function.btn_txt_room_employee"),
					bgColor: "rgba(22, 93, 255, 0.1)",
					url: "/pages/hotelManage/employeeList/employeeList"
				},
				{
					icon: "/static/icons/homemenu/v2/view.png",
					label: i18n.global.t("function.btn_txt_room_preview"),
					bgColor: "rgba(22, 93, 255, 0.1)",
					url: `/pages/hotelDisplay/hotelDisplay?hotel_id=${hotel_id.value}`
					//url: `/pages/hotelDisplay/list-news/list-news?hotel_id=${hotel.value?._id}`

				}],

			},
			{
				title: i18n.global.t("function.title_fm"),
				title_icon: "/static/icons/homemenu/financia-green.png",
				title_color: "rgb(30,30,30)",
				menu_item_list: [{
					icon: "/static/icons/homemenu/v2/income.png",
					label: i18n.global.t("function.btn_txt_income_expense"),
					bgColor: "rgba(72,187,120,0.1)",
					url: "/pages/financialManagement/inExManage/inExManage"
				},
				// {
				// 	icon: "/static/icons/homemenu/expense1.png",
				// 	label: "支出管理",
				// 	bgColor: "rgba(72,187,120,0.1)",
				// 	url: "/pages/financialManagement/expense/expense"
				// },
				{
					icon: "/static/icons/homemenu/v2/financial-statistics.png",
					label: i18n.global.t("function.btn_txt_fm_chart"),
					bgColor: "rgba(72,187,120,0.1)",
					url: "/pages/financialManagement/fmchart/fmchart"
				}
				]

			},
			{
				title: i18n.global.t("function.title_order"),
				title_icon: "/static/icons/homemenu/order-manage.png",
				title_color: "rgb(30,30,30)",
				menu_item_list: [{
					icon: "/static/icons/homemenu/v2/order.png",
					label: i18n.global.t("function.btn_txt_order"),
					bgColor: "rgba(237,137,54,0.1)",
					url: "/pages/order/orderList/orderList"
				},
				{
					icon: "/static/icons/homemenu/v2/order-add.png",
					label: i18n.global.t("function.btn_txt_create_order"),
					bgColor: "rgba(237,137,54,0.1)",
					url: "/pages/order/createOrder/createOrder"
				}
				]

			}, {
				title: i18n.global.t("function.btn_txt_daily_routine"),
				title_icon: "/static/icons/homemenu/order-manage.png",
				title_color: "rgb(30,30,30)",
				menu_item_list: [
					{
						icon: "/static/icons/homemenu/v2/linen.png",
						label: i18n.global.t("washingOrder.title"),
						bgColor: "rgba(237,137,54,0.1)",
						url: "/pages/working/LinenWashing/LinenWashingList"
					}
				]
			}
		]
	})
	const w = state.viewWidth;
	const columnNum = computed(() => {
		let num = 3;
		const w = state.viewWidth;
		if (w != 0) {
			num = Math.floor((w - 30) / 80);
		}
		return num
	})
	const navEvent=(url:string)=>{
		uni.navigateTo({
			url:url
		})
	}
	onLoad(() => {
		uni.setNavigationBarTitle({
			title: i18n.global.t("function.title_navbar")
		})
	})
	const cssVars = computed(() => {
		return {
			"--minItemWidth": `65px`,
			"--maxItemWidth": `120px`,
			"--margin--": `7px`,
			"--conatinerMargin": `-7px`
		}
	})
</script>

<style lang="scss">
	.top-header {
		width: 100%;
		background: #1677ff;
		padding: 60px 0 40px;
		text-align: center;
	}

	.header-title {
		font-size: 22px;
		color: #fff;
		font-weight: 500;
		padding-left: 14px;
	}

	// 最外层卡片
	.card {
		margin: 14px;
		padding: 14px;
		background-color: #fff;
		border-radius: 12px;
	}

	// 标题区域（独立平级class，不再嵌套在.card内部）
	.card-title {
		padding: 5px 5px 15px 5px;
		color: #1f2937;
		font-weight: 700;
		font-size: 24px;
		display: flex;
		flex-direction: row;
		align-items: flex-end;
	}

	// 标题图标
	.icon-stye123 {
		width: 18px;
		height: 18px;
		margin-right: 4px;
	}

	// 标题文字
	.txt {
		color: #1f2937;
		font-weight: 700;
	}
	.item-container{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: stretch;
		margin: var(--conatinerMargin);
	}
	.item{
		 flex:1;
		min-width: var(--minItemWidth);
		// height: 150px;
		// background: red;
		margin: var(--margin--);
		// border-radius: 6px;
	}
	.fill {
		flex: 1;
		min-width: var(--minItemWidth);
		margin: 0 var(--margin--);
		height: 0;
		visibility: hidden;
	}
	// 单个功能项容器
	.item-content {
		
		overflow: hidden;
		// background-color: red;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	// 图标外层容器
	.groupIcon {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
	}

	// 功能小图标
	.icon-style {
		width: 30px;
		height: 30px;
	}

	// 功能文字标签
	.label {
		font-size: 14px;
		padding-top: 8px;
		color: #64748b;
		overflow: hidden;
		text-align: center;
	}
</style>