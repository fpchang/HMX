<template>
	<uni-tab style="flex: 1" :active-index="activeIndex" :tab-bar-height="70" :tabContentHeightFull="true"
		@change="handleChange">
		<uni-tab-content>
			<home></home>
		</uni-tab-content>
		<uni-tab-content>
			<orderState></orderState>
		</uni-tab-content>
		<uni-tab-content>
			<fm></fm>
		</uni-tab-content>
		<uni-tab-content>
			<homeMenu></homeMenu>
		</uni-tab-content>
		<uni-tab-content>
			<mine></mine>
		</uni-tab-content>

		<uni-tab-bar class="custom-tab-list-shell custom-tab-list-root">
			
			<view class="menu-container-style">
				<rice-subsection class="tab-bar-style" :list="listTabName" v-model="activeIndex" shape="round"
					bar-class="bar-class" active-text-class="active-text-class" @clickSub="switchTabEvent" item-class="item-class-style">
					<template #default="{index,subname}">
						<view class="slot-item-class">
							<image style="width:20px;height:20px" v-if="activeIndex==index" class="slot-icon"
								:src="tabBarList[index].selectedIconPath"></image>
							<image style="width:20px;height:20px" v-else class="slot-icon"
								:src="tabBarList[index].iconPath"></image>
							<text
								:class="activeIndex==index?'active-text-class slot-text':'slot-text'">{{subname}}</text>
						</view>

					</template>
				</rice-subsection>
			</view>

		</uni-tab-bar>
	</uni-tab>
</template>

<script setup lang="uts">
	import { state } from "@/store/store";
	import { setToken, setViewWidth } from "@/store/store.uts";
	import home from "@/pages/home/home.uvue";
	import orderState from "@/pages/order/orderState/orderState.uvue";
	import fm from "@/pages/financialManagement/financiaHome/financiaHome";
	import homeMenu from "@/pages/homeMenu/homeMenu.uvue";
	import mine from "@/pages/mine/mine.uvue";
	import i18n from '@/i18n/index.uts';
	const activeIndex = ref<number>(0);
	type TabBarItem = {
		pagePath : string,
		iconPath : string,
		selectedIconPath : string,
		text : string
	}

	// uni.setTabBarItem({ index: 0, text: i18n.global.t('tab.home') });
	// uni.setTabBarItem({ index: 1, text: i18n.global.t('tab.roomStatus') });
	// uni.setTabBarItem({ index: 2, text: i18n.global.t('tab.finance') });
	// uni.setTabBarItem({ index: 3, text: i18n.global.t('tab.function') });
	// uni.setTabBarItem({ index: 4, text: i18n.global.t('tab.mine') });
	const tabBarList : Array<TabBarItem> = [{
		"pagePath": "pages/index/index",
		"iconPath": "/static/icons/tabbar/home-black.png",
		"selectedIconPath": "/static/icons/tabbar/home-blue.png",
		"text": i18n.global.t('tab.home')// "首页"
	},
	{
		"pagePath": "pages/order/orderState/orderState",
		"iconPath": "/static/icons/tabbar/ft-black.png",
		"selectedIconPath": "/static/icons/tabbar/ft-blue.png",
		"text": i18n.global.t('tab.roomStatus')//"房态"
	},
	{
		"pagePath": "pages/financialManagement/financiaHome/financiaHome",
		"iconPath": "/static/icons/tabbar/fm-black.png",
		"selectedIconPath": "/static/icons/tabbar/fm-blue.png",
		"text": i18n.global.t('tab.finance')// "财务"
	},

	{
		"pagePath": "pages/homeMenu/homeMenu",
		"iconPath": "/static/icons/tabbar/fun-black.png",
		"selectedIconPath": "/static/icons/tabbar/fun-blue.png",
		"text": i18n.global.t('tab.function')// "功能"
	},
	{
		"pagePath": "pages/mine/mine",
		"iconPath": "/static/icons/tabbar/mine-black.png",
		"selectedIconPath": "/static/icons/tabbar/mine-blue.png",
		"text": i18n.global.t('tab.mine')//"我的"
	}
	]
	const listTabName = computed<Array<string>>(() => {
		const result : Array<string> = [];
		tabBarList.forEach((item : TabBarItem) => {
			result.push(item.text);
		});
		return result;
	});
	function syncNavigationBar(index : number) : void {
		switch (index) {
			case 0:
				uni.setNavigationBarTitle({ title: '精选' })
				uni.setNavigationBarColor({
					frontColor: '#000000',
					backgroundColor: '#dff3e8'
				})
				break
			case 1:
				uni.setNavigationBarTitle({ title: '趋势' })
				uni.setNavigationBarColor({
					frontColor: '#000000',
					backgroundColor: '#f6ddbf'
				})
				break
			case 2:
				uni.setNavigationBarTitle({ title: '我的' })
				uni.setNavigationBarColor({
					frontColor: '#000000',
					backgroundColor: '#dde7ea'
				})
				break
		}
	}

	function handleChange(index : number) : void {
		activeIndex.value = index
		//syncNavigationBar(index)
		uni.showToast({
					title:"666666"
				})
		
	}
	const switchTabEvent = () => {
		 uni.vibrateShort({
			 type:'light',
		      success: () => {
		       // updateStatus(`${getShortTypeLabel(type)}调用成功`)
			   // console.log('vib success')
		      },
		      fail: (err) => {
				 // console.log(err)
		        //updateStatus(`短振动调用失败：${err.errMsg}`)
		      }
		    })
	}
	const setTokenEvent = () => {
		const token = uni.getStorageSync("hm_token") as string;
		if (token != null && token != "") {
			setToken(token);
		}
	
	}
	onLoad(() => {
		if(state.token==""){
			setTokenEvent();
		}
	})
</script>

<style>
	.custom-panel {
		flex: 1;
		padding-top: 28px;
		padding-right: 24px;
		padding-bottom: 24px;
		padding-left: 24px;
		flex-direction: column;
		justify-content: center;
	}

	.custom-panel-emerald {
		background-color: #dff3e8;
	}

	.custom-panel-sand {
		background-color: #f6ddbf;
	}

	.custom-panel-ink {
		background-color: #dde7ea;
	}

	.custom-panel-kicker {
		font-size: 12px;
		color: rgba(34, 51, 59, 0.56);
	}

	.custom-panel-title {
		margin-top: 10px;
		font-size: 30px;
		color: #22333b;
	}

	.custom-panel-desc {
		margin-top: 10px;
		font-size: 15px;
		line-height: 22px;
		color: rgba(34, 51, 59, 0.74);
	}

	.custom-tab-list-shell {
		/* background-color: rgba(255,255,255,0.6); */
	}

	.custom-tab-list-root {
		/* background-color: red; */
		/* background: linear-gradient(to right, #f7d9a8, #c6ece3); */
		height: 70px;
		border-top-width: 0px;
		background-color: rgba(255, 255, 255, 0);
		display: flex;
		padding: 0 20px;
		box-sizing: border-box;
		flex-direction: row;
		justify-content: center;
	}
	.menu-container-style{
		flex:1;
		max-width: 450px;
		/* #ifdef APP-ANDROID */
			padding-bottom:20px
		/* #endif */
	}
	.custom-tab-cell {
		width: 100%;
		height: 100%;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.custom-tab-label {
		font-size: 14px;
		color: rgba(34, 51, 59, 0.58);
	}

	.custom-tab-label-active {
		color: #1d9f5f;
	}

	.tab-bar-style {
		height: 52px;
		background-color: rgba(255, 255, 255, 0.72);
		border: 1rpx solid rgba(240, 240, 240, 0.9);
	/* 	box-shadow:0px 0px 18px 4px #4040400d; */
}

	.bar-class {
		/* background: rgba(255, 255, 255, 0.96) !important; */
		background: rgba(0, 122, 255, 0.1) !important;
	}
	.item-class-style{
		padding:4px 0;
	}

	.active-text-class {
		color: #007aff !important;
		transform: scale(1.03) !important;
		font-weight: bold;
	}

	.slot-item-class {
		height: 50px;
		display: flex;
		justify-content: center;
		align-items: center;
		

	}

	.slot-text {
		text-align: center;
		font-size: 12px;
		padding-top: 2px
	}
</style>
