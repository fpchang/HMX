<template>
	<view class="reset-root-page">
		<view class="reset-card-wrap">
			<rice-form :model="userForm" :rules="registerRule" ref="userFormRef" label-width="100px" class="demo-form">
				<rice-form-item name="password" label-position="top">
					<rice-input v-model="userForm['password']" :placeholder="i18n.global.t('login.pach_password')" border="none" type="password" />
				</rice-form-item>
				<rice-form-item name="confirmPassword" label-position="top">
					<rice-input v-model="userForm['confirmPassword']" :placeholder="i18n.global.t('register.valid_password_again') " border="none" type="password" />
				</rice-form-item>
			</rice-form>
			<view style="margin-top: 24px;">
				<rice-button type="primary" :text="i18n.global.t('common.btn_confirm')" class="submit-full-btn" shape="round" @click="resetPasswordSubmit" :loading="submitLoading" />
			</view>
		</view>
	</view>
</template>

<script setup>
	import { FormRules, FormValidateErrors } from "@/uni_modules/rice-ui";
	import { AccountService } from "@/services/AccountService";
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated"
	})
	const emit = defineEmits(["resetPasswordEvent"]);
	const submitLoading = ref(false);
	type userType = {
		password : string,
		confirmPassword : string
	}
	const userForm = ref<userType>({
		password: '',
		confirmPassword: ''
	});
	const userFormRef = ref<RiceFormComponentPublicInstance | null>(null);
	const codeText = ref('获取验证码');
	const codeDisabled = ref(false);	
	const passwordValidator = (value : any | null) => {
		const val = value as string
		if (val.length < 6) return '密码的长度不能小于6位'
		return true
	}
	const passwordConfirmValidator = (value : any | null) => {
		const val = value as string
		if (val.length < 6) return '密码的长度不能小于6位'
		if (val != userForm.value.password) {
			return "两次输入的密码不一致"
		}
		return true
	}
	const registerRule = new Map<string, FormRules[]>([
		[
			"password",
			[
				{ required: true, message: i18n.global.t("login.valid_password") },
				{ validator: passwordValidator },
				{ pattern: /[a-zA-Z].*\d|\d.*[a-zA-Z]/, message: i18n.global.t("login.valid_password") },
			]
		],
		[
			"confirmPassword",
			[
				{ required: true, message: i18n.global.t("login.valid_password") },
				{ validator: passwordConfirmValidator },
				{ pattern: /[a-zA-Z].*\d|\d.*[a-zA-Z]/, message: '密码需要包含字母和数字', trigger: 'change' },
			]
		]
	])
	const resetPasswordSubmit = async ()=>{
		if(submitLoading.value==true){
			return;
		}
		submitLoading.value=true;
		const result = await userFormRef.value!.validate();
		console.log("result", result);
		if (result != true) {
			console.log("校验失败");
			submitLoading.value=false;
			return;
		}
		emit("resetPasswordEvent",userForm.value.password);
	}
</script>

<style>
/* 页面最外层 */
.reset-root-page {
	flex: 1;
}
/* 表单卡片容器 */
.reset-card-wrap {
}
/* 底部提交按钮统一样式 */
.submit-full-btn {
	margin-top: 35px;
	width: 100%;
	height: 50px;
	line-height: 50px;
	background: #007aff;
	color: #fff;
	border-radius: 25px;
	font-size: 17px;
	font-weight: 500;
	border: none;
}
</style>