<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>
				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("hotel.room_type_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="nav-add-roomtype-btn" @click="addRoomType">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>
				<text class="nav-btn-text">{{i18n.global.t("hotel.title_room_type")}}</text>
			</view>
		</template>
	</rice-navbar>
	<scroll-view style="flex:1" @scroll="scrollPage" v-if="roomTypeList.length>0">
		<view class="roomtype-list-wrap">
			<view class="roomtype-card-item" v-for="(roomType,index) of roomTypeList">
				<view class="roomtype-card-box">
					<view class="card-img-block">
						<image :src="topImg(roomType.firstImages)" style="height: 100%;width: 100%;" mode="aspectFill">
						</image>
					</view>
					<rice-swipe-actions :accordion="true" ref="swipeControlRef">
						<rice-swipe-actions-item :auto-close="true">
							<rice-cell :title="roomType.name"
							:border="false"
								:label="`123`"
								size="large" arrow arrow-direction="left" center :clickable="false">
								<!-- <template #leftIcon>
									<image mode="aspectFill" :src="formatRommTypeImage(order.reservedRoomList[0])"
										style="margin-right:8px;width: 100px;height:110px;border-radius: 12px;"
										class="cell-left-icon"></image>
								</template> -->
								<template #title>
									<view class="order-title">
									
									</view>
								</template>
								<template #label>
									<view class="card-title-wrap" >
										<view class="card-title-inner">
											<view class="card-name-price-row">
												<text class="type-name-text">{{roomType.name}}</text>
												<text class="price-num-text">¥{{roomType.priceBase}}</text>
											</view>
											<view >
												
												</view>
											<view class="tag-group-row" style="justify-content: flex-start;margin-bottom: 16px;" @click="viewDetail(roomType)">
												<view>
													<rice-tag :text="`${roomType.area}㎡`" text-color="#4e5969" color="#f2f3f5"
														:round="true" />
												</view>
												<view style="margin-left: 8px;" v-for="it of roomType.bedList">
													<rice-tag :text="`${it['name']}*${it['count']}`" text-color="#4e5969"
														color="#f2f3f5" text-size="12px" :round="true" />
												</view>
											</view>
											<view class="room-count-operate-row">
												<!-- <rice-cell :title="i18n.global.t('hotel.room_count')" :value="roomType.roomList.length" :arrow="true" to="`/pages/hotelManage/roomList/roomList?roomType_id=${roomType._id}`"></rice-cell> -->
												<!-- <navigator :url="`/pages/hotelManage/roomList/roomList?roomType_id=${roomType._id}`">
													<view style="display: flex;flex-direction: row;align-items: center;">
														<text
															style=" font-weight:400;color: #1d2129;font-size: 14px;">{{i18n.global.t("hotel.room_count")}}：</text>
														<text class="room-count-text"
															style="color: #00b42f;font-size: 14px;padding:0 4px;">{{roomType.roomList.length}}</text>
														<text style="color: #4e5969;font-size: 14px;">
															{{i18n.global.t("hotel.unit_room")}}</text>
														<rice-icon name="arrow-right" />
													</view>
												</navigator> -->
												<!-- <view style="display: flex;flex-direction:row; align-items: center;">
												<xt-control @del="deleteRoomType(roomType)" @view="viewDetail(roomType)"
														@edit="editRoomType(roomType)"></xt-control>
												</view> -->
											</view>
										</view>
									</view>
								</template>
								<template #rightIcon>
									<rice-icon name="double-left" style="margin-left: 15px;" />
								</template>
							</rice-cell>
							<template #right>
								<view class="swipe-menu-container">
									<view class="menu-item-box menu-detail" @click="viewDetail(roomType)">
										<rice-icon name="eyes" color="#fff" />
										<text class="menu-item-text">{{i18n.global.t("common.btn_txt_details",[''])}}</text>
									</view>
									<view class="menu-item-box menu-edit" @click="editRoomType(roomType)">
										<rice-icon name="edit" color="#fff" />
										<text class="menu-item-text">{{i18n.global.t("common.btn_txt_edit")}}</text>
									</view>
									<view class="menu-item-box menu-del" @click="deleteRoomType(roomType)">
										<rice-icon name="delete" color="#fff" />
										<text class="menu-item-text">{{i18n.global.t("common.btn_txt_delete")}}</text>
									</view>
								</view>
							</template>
						</rice-swipe-actions-item>
					</rice-swipe-actions>
					<rice-cell :border="false" :title="i18n.global.t('hotel.room_count')" :value="roomType.roomList.length" :arrow="true" :url="`/pages/hotelManage/roomList/roomList?roomType_id=${roomType._id}`"></rice-cell>
					<view class="empty-control-block"></view>
				</view>
				
				
				
				
				
				
				
			</view>
		</view>
	</scroll-view>
	<view style="margin-top:80px" v-if="roomTypeList.length<1">
		<l-empty :description="i18n.global.t('common.noData',[''])" />
	</view>
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { state } from "@/store/store";
	import { emergency_phone_number } from "@/static/utils/telphone_transform.uts";
	import { comFunction } from "@/pages/index/ComFuc.uts";
	import { roomTypeService } from "@/services/roomTypeService";
	import { roomTypeBean } from "@/bean/roomTypeBean.uts";
	import { hotelBean } from "@/bean/hotelBean";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated"
	})
	let submitLoading = ref(false);

	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const hotelList = computed<Array<hotelBean>>(() => {
		return state.hotelList;
	});
	const permissionList = computed<Array<string>>(() => {
		return state.permissionList;
	});
	const roomTypeList = computed<Array<roomTypeBean>>(() => {
		return state.roomTypeList;
	});
	const topImg = (imgUrl : string) : string => {
		if (imgUrl == '') {
			return '/static/images/noimg.png';
		}
		return imgUrl;
	};
	const belong = (phone : string) : string => {
		return emergency_phone_number(phone)
	}
	const roleFormat = (val : string) : string => {
		const p : Map<string, string> = new Map([
			["administrator", "超级管理员"],
			["manager", "管理员"],
			["normal", "员工"]
		]);
		return p.get(val) ?? val;
	}
	let showControl_id = ref("");
	const getRoomTypeId = (roomType : UTSJSONObject) : string => {
		const idObj = roomType["_id"] as UTSJSONObject;
		return idObj["_value"] as string;
	}
	const showControl = (roomType : UTSJSONObject) => {
		showControl_id.value = getRoomTypeId(roomType);
	}
	const isShowMenu = (roomType : UTSJSONObject) => {
		return getRoomTypeId(roomType) == showControl_id.value;
	}
	const editRoomType = (roomType : roomTypeBean) => {
		if (!permissionList.value.includes("ROOMTYPE_UPDATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.navigateTo({
			url: `/pages/hotelManage/createRoomType/createRoomType?pageType=1&roomType_id=${roomType._id}`,
		});
	}
	const addRoomType = () => {
		console.log("create", permissionList.value)
		if (!permissionList.value.includes("ROOMTYPE_CREATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.navigateTo({
			url: "/pages/hotelManage/createRoomType/createRoomType"
		});
	}
	const deleteRoomType = async (roomType : roomTypeBean) => {
		if (!permissionList.value.includes("ROOMTYPE_DELETE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}

		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),
			beforeClose: async () : Promise<boolean> => {
				try {
					const flag = await roomTypeService.deleteRoomType(roomType._id);
					if (flag) {
						await comFunction.getRoomTypeList(hotel_id.value);
						hideDialog();
						uni.showToast({
							title: i18n.global.t("common.delete_success"),
							icon: "none"
						});
						return true;
					}
					return false;
				} catch (e) {
					uni.showToast({
						title: i18n.global.t("common.system_error"),
						icon: "none"
					});
					return false;
				}
			},
			confirm: () => {},
			cancel: () => {
				hideDialog();
			}
		});
	}
	const viewDetail = (roomType : roomTypeBean) => {
		uni.navigateTo({
			url: `/pages/hotelManage/createRoomType/createRoomType?pageType=2&roomType_id=${roomType._id}`,
		});
	}
	let scrollTop_val = ref(0);
	const scrollPage = (event : UniScrollEvent) => {
		let { scrollTop } = event.detail;
		scrollTop_val.value = scrollTop
	}
</script>

<style>
/* 导航栏新增房型按钮 */
.nav-add-roomtype-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 12px 15px;
	border-radius: 8px;
}
.nav-btn-text {
	color: #007aff;
	font-size: 15px;
	padding-left: 4px;
}

/* 房型列表外层容器 */
.roomtype-list-wrap {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
/* 单个卡片容器 */
.roomtype-card-item {
	min-width: 320px;
	padding: 15px;
	flex: 1;
}
/* 卡片主体盒子 */
.roomtype-card-box {
	background-color: #fff;
	border-radius: 12px;
}
/* 图片区域 */
.card-img-block {
	height: 350rpx;
	max-height: 200px;
	background-color: #eee;
}
/* 标题内容外层 */
.card-title-wrap {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
/* 	padding: 15px; */
}
/* 标题内部容器 */
.card-title-inner {
	flex: 1;
}
/* 房型名称+价格行 */
.card-name-price-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12px;
}
/* 房型名称文字 */
.type-name-text {
	color: #1d2129;
	font-weight: 700;
	font-size: 18px;
}
/* 价格文字 */
.price-num-text {
	color: #165dff;
	font-size: 20px;
	font-weight: 700;
}
/* 标签组行 */
.tag-group-row {
	margin-top: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* 房间数量+操作行 */
.room-count-operate-row {
	margin-top: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
/* 房间数量数字 */
.room-count-text {
	color: rgb(144, 147, 153);
	font-size: 14px;
	padding-left: 4px;
}
/* 底部空白占位 */
.empty-control-block {
}


	/* 底部操作按钮区域 */
	.btn-control-wrap {
		padding: 0 12px 12px 0;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
		align-items: center;
	}

	.navbar-btn {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 12px 15px;
		border-radius: 8px;
	}

	.navbar-btn-txt {
		color: #007aff;
		font-size: 15px;
		padding-left: 4px;
	}

	/* 侧滑菜单外层 */
	.swipe-menu-container {
		display: flex;
		flex-direction: row;
		height: 100%;
	}
	/* 侧滑每个按钮项 */
	.menu-item-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 70px;
		height: 100%;
	}
.menu-detail {
	background-color: #007aff;
}
.menu-edit {
	background-color: #ff7d00;
}
.menu-del {
	background-color: #f53f3f;
}
/* 菜单文字 */
.menu-item-text {
	color: #fff;
	font-size: 12px;
	margin-top: 4px;
}
</style>
