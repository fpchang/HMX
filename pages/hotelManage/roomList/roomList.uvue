<template>
	<rice-navbar title="">
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>
				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 18px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("hotel.room_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="nav-add-room-btn" @click="addRoom">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>
				<text class="nav-btn-text">{{i18n.global.t("hotel.title_room")}}</text>
			</view>
		</template>
	</rice-navbar>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<view class="search-wrap-root">
			<view class="search-card-box">
				<view class="search-card-row title-row">
					<text class="title-text">{{i18n.global.t("hotel.room_filter")}}</text>
					<l-tag variant="light">{{ i18n.global.t('common.totalCount',[filterRoomList.length.toString()]) }}</l-tag>
				</view>
				<view class="search-card-row select-row">
					<xt-select :columns="columns" v-model="selectId"
					
						:placeholder="i18n.global.t('hotel.pach_search_room_name')"
						@searchInputChange="searchInputChange"></xt-select>
				</view>
				<view class="search-card-row last-row"></view>
			</view>
		</view>
		<view style="padding:14px;border-radius: 14px;">
			<view style="border-radius: 14px;background-color: #fff;">
			  <rice-swipe-actions :accordion="true" ref="swipeControlRef">
			    <rice-swipe-actions-item  :auto-close="true" v-for="room of filterRoomList">
			      <rice-cell :title="room.room_name" :label="getRoomTypeName(room.room_type_id)" size="large" arrow arrow-direction="left"  center :clickable="false" >
					   <template #leftIcon>
					     <image src="/static/icons/roomReserve2.png" style="width: 50px;height:50px;margin-right:8px" class="cell-left-icon"></image>
					   </template>
					  <template #rightIcon>
						  <rice-icon name="double-left"  style="margin-left: 15px;"/>
					  </template>
				  </rice-cell>
			      <template #right>
			        <view class="swipe-menu-wrap">
						<view class="menu-btn-box menu-edit" @click="editRoom(room)">
						  <rice-icon name="edit" color="#fff" />
						  <text class="menu-btn-text">编辑</text>
						</view>
			          <view class="menu-btn-box menu-del" @click="deleteRoom(room)">
			            <rice-icon name="delete" color="#fff" />
			            <text class="menu-btn-text">删除</text>
			          </view>
			        </view>
			      </template>
			    </rice-swipe-actions-item>
			  </rice-swipe-actions>
			</view>
		</view>
		<!-- 注释隐藏列表，仅保留class做兼容，样式全部移除 -->
		<view class="room-card-list-wrap" v-if="false">
			<view class="room-card-item" v-for="room of filterRoomList">
				<view class="room-card-box">
					<view class="room-card-row title-row">
						<text class="room-title-text">{{room.room_name}}</text>
					</view>
					<view class="room-card-row sub-row">
						<text class="sub-text">{{getRoomTypeName(room.room_type_id)}}</text>
					</view>
					<view class="room-card-row last-row">
						<xt-control @del="deleteRoom(room)" @edit="editRoom(room)" :show-view="false"></xt-control>
					</view>
				</view>
			</view>
		</view>
		<l-empty :description="i18n.global.t('common.noData',[''])" v-if="!submitLoading&&filterRoomList.length<1" />
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { roomBean } from '@/bean/roomBean';
	import { state } from "@/store/store";
	import { roomTypeService } from "@/services/roomTypeService";
	import { comFunction } from "@/pages/index/ComFuc";
	import { userBean } from "@/bean/userBean";
	import { SwipeActionsMenu, SwipeActionsItemClick, SwipeActionsItemOpen, SwipeActionsItemClose } from '@/uni_modules/rice-ui'
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated"
	})
	let submitLoading = ref(false);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const user = computed<userBean>(() => {
		return state.user;
	});
	const permissionList = computed(() => {
		return state.permissionList;
	});
	const roomTypeList = computed<Array<roomTypeBean> | null>(() => {
		return state.roomTypeList;
	});
	const selectId = ref("all");
	const search_key = ref("");
	const columns = computed<Array<Array<PickerOption>>>(() => {
		if (roomTypeList.value == null) {
			return []
		}
		let result : Array<Array<PickerOption>> = [];
		let list : Array<PickerOption> = [{ text: i18n.global.t("hotel.all_roomType"), value: "all" }];
		roomTypeList.value.forEach(item => {
			list.push({ text: item.name, value: item._id } as PickerOption);
		});
		result.push(list);
		return result;
	});
	let filterRoomList = computed<Array<roomBean>>(() => {
		if (roomTypeList.value == null) {
			return []
		}
		let roomList : Array<roomBean> = [];
		roomTypeList.value.forEach(item => {
			if (selectId.value == "all" || selectId.value == item._id) {
				item.roomList.forEach(it => {
					if (it.room_name.includes(search_key.value)) {
						roomList.push(it);
					}
				})
			}
		});
		return roomList;
	});
	const searchInputChange = (value : string) => {
		search_key.value = value;
	}
	const selectRoomType = (val : string) => {
		console.log("val", val)
		if (selectId.value == val) {
			return;
		}
		selectId.value = val;
	}
	const getRoomTypeName = (room_type_id : string) : string => {
		if (roomTypeList.value != null) {
			let obj = roomTypeList.value.find(item => item._id == room_type_id) as roomTypeBean;
			return obj.name;
		}
		return "-"
	}
	const swipeControlRef  = ref<RiceSwipeActionsComponentPublicInstance  | null>(null)
	const closeSwiper = () => {
	  swipeControlRef.value!.closeAll!();
	}
	const addRoom = async () => {
		if (!permissionList.value.includes("ROOMTYPE_CREATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		if (roomTypeList.value != null && roomTypeList.value.length < 1) {
			uni.showToast({
				title: i18n.global.t("hotel.tips_create_room_type"),
				icon: 'none'
			})
			return;
		}
		uni.navigateTo({
			url: `/pages/hotelManage/createRoom/createRoom`
		});
	}
	const deleteRoom = async (room : roomBean) => {
		if (submitLoading.value == true) {
			return;
		}
		if (!permissionList.value.includes("ROOMTYPE_DELETE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),
			beforeClose: async () : Promise<boolean> => {
				try {
					const flag = await roomTypeService.deleteRoom(room._id);
					if(flag){
						await comFunction.getRoomTypeList(hotel_id.value);
						hideDialog();
						uni.showToast({
							title: i18n.global.t("common.delete_success"),
							icon: "none"
						});
						closeSwiper();
						return true;
					}
					return false;
				} catch (e) {
					uni.showToast({
						title: i18n.global.t("common.system_error"),
						icon: "none"
					});
					return false;
				}
			},
			confirm: () => {},
			cancel: () => {
				hideDialog();
			}
		});
	}
	const editRoom = async (room : roomBean) => {
		if (!permissionList.value.includes("ROOMTYPE_UPDATE")) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		closeSwiper();
		uni.navigateTo({
			url: `/pages/hotelManage/editRoom/editRoom?pageType=1&&room=${encodeURIComponent(JSON.stringify(room))}`,
		});
	}
	// const reform = async ()=>{
	// 	console.log("000000")
	// 	if(hotel_id.value!=""){
	// 		const db = uniCloud.databaseForJQL();
	// 		const res = await db.collection("hm-room").get();
	// 		console.log("roomlist===",res);
	// 		res.data.forEach(async item=>{
	// 			//console.log(item);
	// 			const room_type_id = item.room_type_id;
	// 			const roomTypeRes = await db.collection("hm-roomType").where({_id:room_type_id}).get();
	// 			console.log("roomType==",roomTypeRes);
	// 			const hotelId = roomTypeRes.data[0].hotel_id;
	// 			console.log("hotelId",hotelId);
	// 			await db.collection("hm-room").doc(item._id).update({hotel_id:hotelId});
	// 		})
	// 	}
		
	// }
	onLoad(params => {
		try {
			const roomType_id = params.getString("roomType_id") ?? "";
			if (roomType_id != "") {
				selectRoomType(roomType_id);
			}
		} catch (e) { }
	})
</script>

<style>
/* 顶部筛选区域外层 */
.search-wrap-root {
	padding: 18px;
}
/* 筛选卡片容器 */
.search-card-box {
	background-color: #fff;
	border-radius: 8px;
	padding: 16px;
}
/* 卡片通用行 */
.search-card-row {
	margin-bottom: 15px;
}
/* 最后一行取消底部间距 */
.last-row {
	margin-bottom: 0;
}
/* 标题行布局 */
.title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* 标题文字 */
.title-text {
	padding-right: 8px;
	font-size: 18px;
	font-weight: 700;
	color: #999;
}
/* 筛选下拉行 */
.select-row {
}

/* 导航栏新增按钮 */
.nav-add-room-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
}
.nav-btn-text {
	margin-left: 4px;
	font-size: 15px;
	color: #007aff;
}

/* 侧滑菜单外层容器 */
.swipe-menu-wrap {
	display: flex;
	flex-direction: row;
	height: 100%;
}
/* 侧滑单个按钮 */
.menu-btn-box {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding:0 15px;
	height: 100%;
}
/* 菜单文字 */
.menu-btn-text {
	color:#fff;
	font-size: 14px;
	padding-left: 4px;
}
/* 编辑按钮背景 */
.menu-edit {
	background-color: #409EFF ;
}
/* 删除按钮背景 */
.menu-del {
	background-color: #F56C6C ;
}

/* 列表左侧图标 */
.cell-left-icon {
}

/* 下方备用卡片列表外层（页面注释隐藏） */
.room-card-list-wrap {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.room-card-item {
	min-width: 320px;
	padding: 15px;
	flex: 1;
}
.room-card-box {
	background-color: #fff;
	border-radius: 12px;
	padding: 16px;
}
.room-card-row {
	margin-bottom: 12px;
}
/* 卡片标题文字 */
.room-title-text {
	font-size: 18px;
	font-weight: 700;
	color: #1d2129;
}
/* 副标题文字 */
.sub-text {
	color: #6b7280;
	font-size: 14px;
}
</style>