export type AuthProvider = 'apple' | 'huawei' | 'google'

export type AuthPlatform = 'ios' | 'android' | 'harmony'

export type AuthScope = 'email' | 'fullName' | 'profile' | 'openid'

export type AuthCredentialState = 'authorized' | 'revoked' | 'notFound' | 'transferred' | 'unknown'

export type AuthLoginOptions = {
  /**
   * Optional nonce passed to providers that support replay protection.
   * The backend should verify the same value when validating provider tokens.
   */
  nonce?: string
  /**
   * Optional state value for provider flows that support CSRF protection.
   */
  state?: string
  /**
   * Requested provider scopes. iOS Apple only uses email and fullName.
   * Omit scopes to request no extra information where supported.
   */
  scopes?: AuthScope[]
  /**
   * Google Sign in requires the Web client ID, not the Android client ID.
   */
  googleWebClientId?: string
  /**
   * Huawei AppGallery Connect client ID. Required by the full Huawei SDK flow.
   */
  huaweiClientId?: string
  success?: (res: AuthLoginResult) => void
  fail?: (res: AuthLoginFail) => void
  complete?: (res: any) => void
}

export type AuthLoginResult = {
  errMsg: string
  provider: AuthProvider
  platform: AuthPlatform
  /**
   * Stable provider user identifier. Use it only after backend verification.
   */
  userId?: string
  idToken?: string
  authorizationCode?: string
  email?: string
  nickname?: string
  avatarUrl?: string
  fullName?: string
  /**
   * Apple realUserStatus raw value.
   */
  realUserStatus?: number
  raw?: any
}

/**
 * - 9100001 Unsupported platform.
 * - 9100002 Unsupported provider on the current platform.
 * - 9100003 Provider SDK/configuration is missing.
 * - 9100004 Provider is not available on this device.
 * - 9100005 User cancelled authorization.
 * - 9100006 Native authorization failed.
 * - 9100007 Native credential is missing required identity data.
 */
export type AuthLoginErrorCode =
  9100001 |
  9100002 |
  9100003 |
  9100004 |
  9100005 |
  9100006 |
  9100007

export interface AuthLoginFail extends IUniError {
  errCode: AuthLoginErrorCode
}

export type AuthLogin = (options?: AuthLoginOptions) => void

export type IsProviderAvailable = () => boolean

export type GetProvider = () => AuthProvider

export type GetCredentialState = (userId: string) => Promise<AuthCredentialState>

export function createLoginOptions(): AuthLoginOptions {
  return {}
}
