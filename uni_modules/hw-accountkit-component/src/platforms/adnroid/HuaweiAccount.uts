import { LoginResult, LoginCallback } from '../HuaweiAccount.uts';

// 导入华为 Account Kit 相关类（需确保 SDK 已集成）
import com.huawei.hms.api.HuaweiApiAvailability;
import com.huawei.hms.support.hwid.HuaweiIdAuthManager;
import com.huawei.hms.support.hwid.request.HuaweiIdAuthParams;
import com.huawei.hms.support.hwid.request.HuaweiIdAuthParamsHelper;
import com.huawei.hms.support.hwid.result.AuthHuaweiId;
import com.huawei.hms.support.hwid.service.HuaweiIdAuthService;

export class HuaweiAccount {
  private static authService: HuaweiIdAuthService | null = null;

  static quickLogin(clientId: string, callback: LoginCallback): void {
    // 1. 检查华为移动服务（HMS）是否可用
    val isHmsAvailable = HuaweiApiAvailability.getInstance().isHuaweiMobileServicesAvailable(getContext()) == com.huawei.hms.api.ConnectionResult.SUCCESS;
    if (!isHmsAvailable) {
      callback({
        code: "",
        message: "华为移动服务未安装或版本过低",
        success: false
      });
      return;
    }

    // 2. 构建授权参数
    val authParams = HuaweiIdAuthParamsHelper(HuaweiIdAuthParams.DEFAULT_AUTH_REQUEST_PARAM)
      .setClientId(clientId)
      .setAuthorizationCode() // 获取授权码（用于后端换token）
      .createParams();

    // 3. 创建授权服务
    this.authService = HuaweiIdAuthManager.getService(getContext(), authParams);

    // 4. 发起登录请求
    val task = this.authService?.silentSignIn(); // 静默登录（一键登录核心）
    task?.addOnSuccessListener { authHuaweiId: AuthHuaweiId ->
      // 登录成功：返回授权码
      callback({
        code: authHuaweiId.authorizationCode,
        message: "登录成功",
        success: true
      });
    }?.addOnFailureListener { e: Throwable ->
      // 静默登录失败，触发手动授权登录
      val intent = this.authService?.getSignInIntent();
      startActivityForResult(intent, 1001, (resultCode, data) => {
        if (resultCode == android.app.Activity.RESULT_OK && data != null) {
          val authHuaweiId = HuaweiIdAuthManager.parseAuthResultFromIntent(data);
          if (authHuaweiId != null) {
            callback({
              code: authHuaweiId.authorizationCode,
              message: "手动登录成功",
              success: true
            });
          } else {
            callback({
              code: "",
              message: "登录结果解析失败",
              success: false
            });
          }
        } else {
          callback({
            code: "",
            message: "用户取消登录",
            success: false
          });
        }
      });
    };
  }

  static logout(): void {
    this.authService?.signOut()?.addOnSuccessListener {
      console.log("退出登录成功");
    }?.addOnFailureListener { e: Throwable ->
      console.log("退出登录失败：" + e.message);
    };
  }
}