<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>

				<image src="/static/icons/list.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text
					style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{i18n.global.t("finance.income_expense_list")}}</text>
			</view>
		</template>
		<template #right>
			<view class="navbar-btn">
				<image src="/static/icons/operation/add.png" style="width:18px;height: 18px;"></image>

				<text class="txt"
					@click="addFm">{{billType=='income'?i18n.global.t("common.btn_txt_create",[i18n.global.t("finance.income")]):i18n.global.t("common.btn_txt_create",[i18n.global.t("finance.expense")])}}</text>


			</view>
		</template>
	</rice-navbar>
	<scroll-view style="flex:1">
		<view class="search-area">
			<view class="card">
				<view class="card-item title-area">
					<text class="txt">{{i18n.global.t("finance.income_expense_filter")}}</text>
					<l-tag variant="light">{{ i18n.global.t('common.totalCount',[fmResult.count]) }}</l-tag>
				</view>
				<view class="card-item  select-area" style="margin-bottom: 0;">
					<fmSearchComponent :columns="columns" :initDateRange="dateRange"
						@searchInputChange="searchInputChange" @selectAction="selectFm" @dateChange="dateChange"
						@searchAction="getFmList" :placeholder="i18n.global.t('form.pach_remark')"></fmSearchComponent>
				</view>
				<!-- <view class="card-item search"></view> -->
			</view>

		</view>

		<view style="padding:14px;border-radius: 14px;">
			<view style="border-radius: 14px;background-color: #fff;">
				<rice-swipe-actions :accordion="true" ref="swipeControlRef">
					<rice-swipe-actions-item :auto-close="true" v-for="fm of fmResult.fmList">
						<rice-cell :title="`${formatTypeName(fm.type)}`" :label="formatDate(fm.ioeTime)"
							:value="`${fm.billType=='income'?'+':'-'}${fm.amount}`" size="large" arrow
							arrow-direction="left" center @click="viewFm(fm)">
							<template #leftIcon>
								<image v-if="fm.billType=='income'" src="/static/icons/fm/income-orange.png"
									style="margin-right:8px;width: 40px;height:40px;" class="left-cion"></image>
								<image v-if="fm.billType=='expenses'" src="/static/icons/fm/expense-orange.png"
									style="margin-right:8px;width: 40px;height:40px;" class="left-cion"></image>
							</template>
							<template #rightIcon>
								<rice-icon name="double-left" color="#909399" style="margin-left: 15px;" />
							</template>


						</rice-cell>
						<view>

						</view>
						<template #right>
							<view class="swiper-menu-style">
								<view class="menu-item detail" @click="viewFm(fm)">
									<rice-icon name="eyes" color="#fff" />
									<text class="slot-text">详情</text>
								</view>
								<view class="menu-item edit" @click="editFm(fm)">
									<rice-icon name="edit" color="#fff" />
									<text class="slot-text">编辑</text>
								</view>
								<view class="menu-item del" @click="deleteFm(fm)">
									<rice-icon name="delete" color="#fff" />
									<text class="slot-text">删除</text>
								</view>


							</view>

						</template>
					</rice-swipe-actions-item>
				</rice-swipe-actions>
			</view>
		</view>

		<view style="padding:20px;border-radius: 8px;" v-if="false">

			<rice-collapse :custom-style="{borderRadius:'8px'}">
				<rice-collapse-item v-for="fm of fmResult.fmList" :name="fm._id"
					:title="`${ formatTypeName(fm.type)}:￥${fm.amount}`" :value="formatDate(fm.ioeTime)"
					:title-style="{color:fm.billType=='expenses'?'#b91c1c':'#047857'}" :border="false">
					<template #leftIcon>
						<image src="/static/icons/fm/in.png" style="width: 16px;height: 16px;margin-right: 8px;">
						</image>
					</template>
					<view class="detail_panal">
						<view class="content">
							<view class="card-item">
								<view class="fl-c">
									<image src="/static/icons/fm/time.png" style="width: 16px;height: 16px;"></image>
									<text class="label">{{i18n.global.t("finance.transaction_date")}}：</text>
								</view>
								<text class="val-style">{{formatDate(fm.ioeTime)}}</text>
							</view>
							<view class="card-item">
								<view class="fl-c">
									<image src="/static/icons/fm/sztype.png" style="width: 16px;height: 16px;"></image>
									<text class="label">{{i18n.global.t("finance.voucher_Type")}}：</text>
								</view>
								<text class="val-style">{{formatTypeName(fm.type)}}</text>
							</view>
							<view class="card-item" v-if="fm.billType=='income'">
								<view class="fl-c">
									<image src="/static/icons/fm/income.png" style="width: 16px;height: 16px;"></image>
									<text
										class="label">{{i18n.global.t("finance.income")}}{{i18n.global.t("finance.amount")}}：</text>
								</view>
								<text class="val-style" style="color:#047857">¥{{fm.amount}}</text>
							</view>
							<view class="card-item" v-if="fm.billType=='expenses'">
								<view class="fl-c">
									<image src="/static/icons/fm/expenses.png" style="width: 16px;height: 16px;">
									</image>
									<text
										class="label">{{i18n.global.t("finance.expense")}}{{i18n.global.t("finance.amount")}}：</text>
								</view>
								<text class="val-style" style="color:#b91c1c">¥{{fm.amount}}</text>
							</view>

							<view class="card-item" style="margin-bottom: 0;">
								<view class="fl-c">
									<image src="/static/icons/fm/mark.png" style="width: 16px;height: 16px;"></image>
									<text class="label">{{i18n.global.t("form.remark")}}：</text>
								</view>
								<text class="val-style">
									{{fm.mark}}
								</text>
							</view>
						</view>

						<view class="control">
							<view>
								<xt-control @del="deleteFm(fm)" @edit="editFm(fm)" :show-view="false"></xt-control>
							</view>


						</view>
					</view>
				</rice-collapse-item>

			</rice-collapse>
		</view>
		<view v-if="submitLoading" style="display: flex;flex-direction: row;justify-content: center;">
			<rice-loading color="#787878" :text="i18n.global.t('common.noData',[''])" />
		</view>
		<view v-if="!submitLoading&&fmResult.fmList.length<1">
			<l-empty :description="i18n.global.t('common.noData',[''])" />
		</view>
	</scroll-view>


	<view style="padding:15px 5px;background-color: #fff;display: flex;flex-direction: row;justify-content: center;"
		v-if="!submitLoading&&fmResult!=null&&fmResult.count>fmResult.pageSize">
		<l-pagination v-model="fmResult.pageNo" :disabled="submitLoading" :total="fmResult?.count"
			:page-size="fmResult?.pageSize" :pager-count="5" :hideOnSinglePage="true" @change="pageChange" />
	</view>	
	<page-container :show="showDeatilPage" position="right" :round="true" @afterleave="showDeatilPage=false" custom-style="background-color: #f5f5f7;width:750rpx">
		<view class="container" style="width:750rpx;">
			<view style="margin-top:100px;padding: 14px;display: flex;flex-direction:row;justify-content: center;">
				<view style="background-color: #fff;border-radius: 14px;padding:24px 14px;max-width: 500px;flex:1"> 
					<rice-cell-group>
					  <rice-cell icon="/static/icons/fm/time.png" :title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.transaction_date')" :value="formatDate(active_fm.ioeTime)" :clickable="false"/>
					  <rice-cell icon="/static/icons/fm/sztype.png" :title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.voucher_Type')" :value="formatTypeName( active_fm.type)" :clickable="false"/>
					  <rice-cell v-if=" active_fm.billType=='income'" icon="/static/icons/fm/income.png" :title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.income')" :value="active_fm.amount" :clickable="false"/>
					  <rice-cell v-if=" active_fm.billType=='expenses'" icon="/static/icons/fm/expenses.png" :title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('finance.expense')" :value="active_fm.amount" :clickable="false"/>
					  <rice-cell icon="/static/icons/fm/mark.png" :title-style="{'paddingLeft':'4px'}" center :title="i18n.global.t('form.remark')" :value="active_fm.mark" :clickable="false"/>
					
					</rice-cell-group>
					
							<view style="margin-top:20px"> 
							  <rice-row :gutter="8">
								   <rice-col :span="10"></rice-col>
								   
							    <rice-col :span="6">
							       <view>
							       		<rice-button type="primary" size="small"  plain-fill text="修改" @click="editFm(active_fm)"></rice-button>
							       </view>
							    </rice-col>
							    <rice-col :span="6">
							      <view>
									  <rice-button type="error" size="small" plain-fill text="删除" @click="deleteFm(active_fm)"></rice-button>
								  </view>
							    </rice-col>
							 </rice-row>
							</view>
					
				</view>
			</view>	
		</view>
		
	</page-container>
</template>

<script setup>
	import { showDialog, hideDialog } from "@/uni_modules/rice-ui";
	import { dayuts } from '@/uni_modules/lime-dayuts';
	import { TIME, getMonthDateArray } from "@/static/utils/TIME";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { FMService } from "@/services/FMService";
	import { roomBean } from '@/bean/roomBean';
	import { FMBean, FMDataListResult, FMTypeConfigBean } from '@/bean/FMBean';
	import { state } from "@/store/store";	
	import { fmState,setIncomeAndExpensesConfig } from "@/store/modules/fmStore.uts";
	import { userBean } from "@/bean/userBean";
	import i18n from '@/i18n/index.uts';
	import { comFunction } from "@/pages/index/ComFuc";
	import fmSearchComponent from "./components/fmSearchComponent/fmSearchComponent";
	import expensesInfoCardComponent from "./components/expensesInfoCardComponent/expensesInfoCardComponent";
	import incomeInfoCardComponent from "./components/incomeInfoCardComponent/incomeInfoCardComponent";
	import { SwipeActionsMenu, SwipeActionsItemClick, SwipeActionsItemOpen, SwipeActionsItemClose } from '@/uni_modules/rice-ui'

	let submitLoading = ref(true);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const user = computed<userBean>(() => {
		return state.user;
	});
	const permissionList = computed(() => {
		return state.permissionList;
	})
	const currentPage = ref(1);
	const roomTypeList = computed<Array<roomTypeBean> | null>(() => {
		return state.roomTypeList;
	});
	
	const showDeatilPage=ref(false);
	const active_fm=ref<FMBean | null>(null);

	//选择列表
	let _select_id = ref("income");
	let _search_key = ref("");
	const billType = ref("income");
	const keyword = ref("");//过滤字段
	const dateRange = ref<string[]>(getMonthDateArray());
	const columns = computed<Array<Array<PickerOption>>>(() => {
		let result : Array<Array<PickerOption>> = [[
			{ text: i18n.global.t('finance.income'), value: 'income' },
			{ text: i18n.global.t('finance.expense'), value: 'expense' }
		]];
		return result;
	});

	const incomeAndExpensesConfigList = computed<Array<FMTypeConfigBean>>(()=>{
		return fmState.incomeAndExpensesConfig;
	});
	const getIncomeAndExpensesConfigList = async () => {
		const list = await FMService.getIncomeAndExpensesConfig();
		setIncomeAndExpensesConfig(list);
	}


	const fmResult = ref<FMDataListResult>({
		count: 0,//总数量
		pageNo: 1,//当前页码
		pageSize: 20,//每页数量
		fmList: []//列表
	})
	const getFmList = async () => {
		submitLoading.value = true;
		// uni.showLoading({
		// 	title: ""
		// })
		try {
			const fmr = await FMService.getIncomeAndExpensesDateBySearch(hotel_id.value, billType.value, keyword.value, dateRange.value, fmResult.value.pageNo, fmResult.value.pageSize);
			fmResult.value = fmr as FMDataListResult;
			//uni.hideLoading();
			submitLoading.value = false;
		} catch (e) {
			submitLoading.value = false;
			uni.showToast({
				title: i18n.global.t("common.getData_fail", ['']),
				icon: "none"
			})
		}

	}
	const dateChange = (range : string[]) => {
		dateRange.value = range;
		getFmList();

	}
	const searchInputChange = (k : string) => {
		keyword.value = k;
	}
	const selectFm = (bt : string) => {
		billType.value = bt;
		getFmList();
	}
	const pageChange = (pn : number) => {
		console.log(pn, fmResult.value);
		getFmList();
	}
	const formatDate = (timestamp : number) : string => {
		return dayuts(new Date(timestamp)).format("YYYY-MM-DD");
	}
	const formatTypeName = (type : string) : string => {
		const target = incomeAndExpensesConfigList.value.find(item => item.name == type);
		if (target != null) {
			return target.text
		}
		return "--"
	}
	const swipeControlRef = ref<RiceSwipeActionsComponentPublicInstance | null>(null)
	const closeSwiper = () => {
		swipeControlRef.value!.closeAll!();
	}
	const addFm = async () => {
		if (!permissionList.value.includes(
			"FM_CREATE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.$once("refrushfmList", () => {
			console.log("刷新fmlist");
			getFmList();
		})
		uni.navigateTo({
			url: `/pages/financialManagement/inExManage/createIncomeAndExpense/createIncomeAndExpense?billType=${billType.value}`
		});


	}
	const deleteFm = async (fm : FMBean) => {
		if (submitLoading.value == true) {
			return;
		}
		if (!permissionList.value.includes(
			"ROOMTYPE_DELETE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		console.log("delete")
		showDialog({
			title: i18n.global.t("common.confirmDelete"),
			message: i18n.global.t("common.deleteOrderTip"),
			cancelButtonText: i18n.global.t("common.btn_txt_cancel"),
			confirmButtonText: i18n.global.t("common.btn_confirm"),
			beforeClose: async () : Promise<boolean> => {

				//await roomTypeService.deleteFm(room._id);
				//await comFunction.getRoomTypeList(hotel_id.value);
				try {
					await FMService.deleteFm(fm._id);
					getFmList();
					showDeatilPage.value=false;
					hideDialog();
					return true;
				} catch (errMsg) {
					uni.showToast({
						title: i18n.global.t("common.delete_fail"),
						icon: "none"
					})
					return false;
				}


			},
			confirm: () => {
				console.log("confirm1111111");
				
			}, cancel: () => {
				hideDialog();
			}

		});
	}
	const editFm = async (fm : FMBean) => {
		if (!permissionList.value.includes(
			"ROOMTYPE_UPDATE"
		)) {
			showDialog({
				title: i18n.global.t('permission.noPermission'),
				message: i18n.global.t('permission.contactAdmin'),
				showCancelButton: false,
				confirm: () => {
					hideDialog();
				}
			})
			return;
		}
		uni.$once("refrushfmList", () => {
			getFmList();
		});
		showDeatilPage.value=false;
		uni.navigateTo({
			url: `/pages/financialManagement/inExManage/createIncomeAndExpense/createIncomeAndExpense?pageType=1&fm=${encodeURIComponent(JSON.stringify(fm))}`
		})
	}
	const viewFm=(fm:FMBean)=>{
		active_fm.value=fm;
		showDeatilPage.value=true;
		// uni.$once("refrushfmList", () => {
		// 	getFmList();
		// });	
		// uni.navigateTo({
		// 			url: `/pages/financialManagement/inExManage/inExDetail/inExDetail?fm=${encodeURIComponent(JSON.stringify(fm))}`,
		// 		});
	}
	const init = async () => {
		//let d:MOONTH_START_END_TIMESTAMP=TIME.getTodayStartTimeAndEndTime(new Date());
		await getIncomeAndExpensesConfigList();
		getFmList();
	}
	onPageShow(() => {
		//getFmList();
	})
	init();
</script>

<style lang="scss">
	.search-area {
		padding: 18px;

		.card {
			background-color: #fff;
			border-radius: 8px;
			padding: 16px;

			.card-item {
				margin-bottom: 15px;

				&:last-child {
					margin: 0;
				}
			}

			.title-area {
				display: flex;
				flex-direction: row;
				align-items: center;

				.txt {
					padding-right: 8px;
					font-size: 18px;
					font-weight: 700;
				}
			}

		}
	}

	.card-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;

		.card-list-item {
			min-width: 360px;
			padding: 7.5px 15px;
			flex: 1;

			.card {
				background-color: #fff;
				border-radius: 12px;

				position: relative;

				.icon-area {
					position: absolute;
					right: 10px;
					top: 10px;
				}

				.top-area {
					display: flex;
					flex-direction: row;
					align-items: center;
					height: 60px;
					border-bottom: 1px solid rgba(16, 185, 129, 0.2);
					background-color: #ecfdf5;
					padding: 0 24px;

					.txt {
						// line-height: 60px;
						color: #047857;
						font-size: 18px;
						font-weight: 700;
						padding-left: 4px;
					}

				}

				.top-area-red {
					display: flex;
					flex-direction: row;
					align-items: center;
					height: 60px;
					padding: 0 24px;
					border-bottom: 1px solid rgba(239, 68, 68, 0.2);
					background-color: #fef2f2;

					.txt {
						// line-height: 60px;
						color: #b91c1c;
						font-size: 18px;
						font-weight: 700;
						padding-left: 4px;
					}

				}

				.amount-area {
					padding: 0 24px;
					margin-top: 24px;

					.label {
						color: #6b7280;
						font-size: 14px;
						margin-bottom: 4px;
					}

					.num {
						line-height: 36px;
						color: #047857;
						font-size: 30px;
						font-weight: 700;
					}

					.num-red {
						color: #b91c1c;
					}
				}

				.content {

					.card-item {

						margin-top: 15px;
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: space-between;

						&:first-child {
							margin-top: 0;
						}

						.fl-c {
							display: flex;
							flex-direction: row;
							align-items: center;
						}

						.label {
							color: #787878;
							font-size: 16px;
							padding-left: 8px;
						}

						.val-style {
							color: #787878;
							font-size: 16px;
						}

					}
				}



				.control {

					display: flex;
					flex-direction: row;
					justify-content: flex-end;
					// background-color: #f9fafb;
					align-items: center;
					padding: 0px 20px 24px 0;

					.txt {
						font-size: 20px;
						font-weight: 700;
						color: #f53f3f;
						padding-top: 5px;
					}

					.txt-in {
						color: #00b42a;
					}
				}
			}
		}
	}

	.detail_panal {
		width: 100%;
		flex:1;
		background-color: #fff;
		border-radius: 12px;
		
		.content {

			.card-item {

				margin-top: 15px;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;

				&:first-child {
					margin-top: 0;
				}

				.fl-c {
					display: flex;
					flex-direction: row;
					align-items: center;
				}

				.label {
					color: #787878;
					font-size: 13px;
					padding-left: 8px;
				}

				.val-style {
					color: #787878;
					font-size: 13px;
				}

			}
		}



		.control {

			display: flex;
			flex-direction: row;
			justify-content: flex-end;
			// background-color: #f9fafb;
			align-items: center;


			.txt {
				font-size: 20px;
				font-weight: 700;
				color: #f53f3f;
				padding-top: 5px;
			}

			.txt-in {
				color: #00b42a;
			}
		}
	}
</style>