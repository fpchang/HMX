	// ==================== 景点相关 ====================
	async scenicSpot_addScenicSpot(scenicSpotObj: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.scenicSpot_addScenicSpot({ scenicSpotObj });
