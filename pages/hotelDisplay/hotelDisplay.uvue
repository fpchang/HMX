.info-block {
	padding: 18px;
}
/* 酒店名称行 */
.info-title-row {
}
.info-title-text {
	color: rgb(17, 24, 39);
	font-size: 24px;
	font-weight: 700;
}
/* 地址行 */
.info-addr-row {
	margin-top: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
}
.info-addr-text {
	color: #4b5563;
	font-size: 16px;
	margin-left: 4px;
}
/* 内容板块外层容器 */
.content-container-block {
	padding: 15px;
}
/* 板块标题行 */
.container-title-row {
	border-left: 4px solid #2a5d98;
	padding-left: 12px;
}
.container-title-text {
	color: rgb(17, 24, 39);
	font-size: 18px;
	font-weight: 700;
}
/* 板块内容区域 */
.container-content-wrap {
	margin-top: 16px;
}
/* 标签横向容器 */
.tag-row {
	display: flex;
	flex-direction: row;
}
/* 单个标签盒子 */
.single-tag-box {
	padding: 4px 8px;
}
</style>