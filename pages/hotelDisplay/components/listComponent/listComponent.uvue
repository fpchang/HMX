<template>
	<view>
		<view class="facility-card-box" v-for="item of list">
			<view class="card-title-row">
				<image :src="item.icon" class="title-icon-img"></image>
				<text class="card-title-text">{{item.name}}</text>
			</view>
			<rice-grid :column-num="columnNum" :border="false">
				<rice-grid-item v-for="it in item.support" :key="it" :icon="getConfig(it).icon" :text="getConfig(it).name" />
			</rice-grid>
		</view>
	</view>
</template>

<script setup>
	import { HotelService } from "@/services/HotelService.uts";
	import {facilityConfig_type} from "@/bean/facilityConfig_type.uts";
	import {sf} from "./type.uts";
	import { state } from "@/store/store";
	defineOptions({
		styleIsolation: "isolated"
	})
	const props = defineProps({
		list:{
			type:Array<sf>,
			default:[]
		}
	});
	const columnNum= computed(()=>{
		let num = 3;
		const w = state.viewWidth;
		if(w!=0){
			 num = Math.floor((w-30)/80);
		}
		return num
	})
	console.log("list::",props.list);
	const facilityConfigList = ref<Array<facilityConfig_type>>([]);
	const getConfigList=async ()=>{
		const list:Array<facilityConfig_type> = await HotelService.getConfig_facilityConfig("all");
		console.log("getConfig_facilityConfig",list);
		facilityConfigList.value=list;
	}
	const getConfig = (id:string):facilityConfig_type=>{
		if(facilityConfigList.value.length<1){
			return {
				_id:"",
				icon:"",
				name:"",
				type:""
			}
		}
		const item = facilityConfigList.value.find(item=>item._id == id);
		if(item==null){
			return {
				_id:"",
				icon:"",
				name:"",
				type:""
			}
		}
		return item;
	}
	getConfigList();
</script>

<style>
/* 设施分组卡片容器 */
.facility-card-box {
	margin-bottom: 24px;
	padding:15px 10px;
	background-color: #fff;
	border-radius: 12px;
}
/* 卡片标题行（图标+文字） */
.card-title-row {
	padding: 5px 5px 15px 5px;
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}
/* 标题左侧小图标 */
.title-icon-img {
	width: 18px;
	height: 18px;
	margin-right: 4px;
}
/* 标题文字 */
.card-title-text {
	color: #1f2937;
	font-weight: 700;
	font-size: 16px;
}
</style>