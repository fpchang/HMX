<template>
	<rice-navbar title="">
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>

				<image :src="titleImg" style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text style="font-size: 16px;font-weight: 700;color:rgb(29,33,41);">{{title}}</text>
			</view>
		</template>
		<template #right>

			<view class="navbar-btn" v-if="pageType!=2">
				<rice-button @click="submitForm" type="default" size="mini"
					:text="i18n.global.t('common.btn_txt_save',[''])" color="rgba(0,0,0,0)" textColor="#007aff"
					textSize="14px" :loadingText="i18n.global.t('common.saving')" :loading="submitLoading">
				</rice-button>

			</view>
		</template>
	</rice-navbar>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<view style="padding:15px;border-radius: 12px;background-color: #fff;">
			<xt-form-item :label="i18n.global.t('hotel.form.room_type_name')" tips="" required>
				<view>
					<rice-input style="height: 40px;" placeholderStyle="font-size:14px" classic
						:placeholder="i18n.global.t('hotel.form.path_room_type_name')" borderColor="#dcdfe6"
						:disabled="pageType==2" v-model="roomTypeForm.name"></rice-input>
				</view>
			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.area')" tips="" required>
				<view>
					<rice-stepper v-model="roomTypeForm.area" input-width="42" button-size="38" font-size="15" :min="5"
						:auto-fixed="false" :disabled="pageType==2" integer />
				</view>
			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.max_guests')" required>
				<view>
					<rice-stepper v-model="roomTypeForm.guestNumber" input-width="42" button-size="38" font-size="15"
						:min="1" :auto-fixed="false" :disabled="pageType==2" integer />
				</view>
			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.bed_configuration')" tips="" required>

				<view class="checkbox-group">
					<view style="display: flex;flex-direction: row;margin-right: 20px;margin-bottom: 20px;"
						v-for="item of bedTypeList">
						<rice-checkbox :disabled="pageType==2" :value="item ['name']" :label="item.name"
							v-model="item.checked" />
						<view style="margin-left: 25px;">
							<rice-stepper :disabled="!item.checked||pageType==2" v-model="item.count" input-width="42"
								:min="1" button-size="38" font-size="15" mode="outline" :auto-fixed="false" integer />
						</view>

					</view>
				</view>

			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.room_price')" tips="" required>
				<rice-input style="height: 40px;" placeholderStyle="font-size:14px" classic placeholder="请输入价格"
					borderColor="#dcdfe6" :disabled="pageType==2" type="digit" v-model="priceBase"></rice-input>

			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.facilities_amenities')" tips="" required>

				<rice-checkbox-group @change="recreationCheckboxChange" direction="row" v-model="roomTypeForm.facility">
					<view style="display: flex;flex-direction: row;margin-right: 20px;margin-bottom: 20px;"
						v-for="item in facilityConfig_roomType">
						<rice-checkbox :disabled="pageType==2" :value="item ['_id']" :label="item.name" />
					</view>
				</rice-checkbox-group>
			</xt-form-item>

			<xt-form-item :label="i18n.global.t('hotel.form.cover_image')" tips="" required>
				<view>
					<xt-file-upload :max-count="1" :filePath="`HM/client/${hotel_id}/roomType`"
						:default_files_list="[roomTypeForm.firstImages]" @uploadSuccess="uploadFirstImageSuccess"
						accept="image" :readonly="pageType==2" :deletable="pageType!=2"></xt-file-upload>
				</view>
			</xt-form-item>
			<xt-form-item :label="i18n.global.t('hotel.form.room_type_images')" tips="" required>
				<view>
					<xt-file-upload :max-count="3" :default_files_list="roomTypeForm.imagesList"
						@uploadSuccess="uploadImageListSuccess" :filePath="`HM/client/${hotel_id}/roomType`"
						accept="image" :readonly="pageType==2" :deletable="pageType!=2"></xt-file-upload>
				</view>
			</xt-form-item>

		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup>
	import { FormRules, FormValidateErrors } from "@/uni_modules/rice-ui";
	import { state } from '@/store/store.uts';
	import { roomTypeBean, bedBean } from "@/bean/roomTypeBean.uts";
	import { comFunction } from "@/pages/index/ComFuc.uts";
	import { HotelService } from "@/services/HotelService.uts";
	import { roomTypeService } from "@/services/roomTypeService.uts";
	import { validRoomTypeForm } from "./roomTypeFormVaild.uts";
	import { userBean } from "@/bean/userBean";
	import { facilityConfig_type } from "@/bean/facilityConfig_type.uts";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated" // 默认隔离；外部覆盖改为 app-and-page
	})
	type bedType = {
		name : string,
		checked : boolean,
		count : number
	};
	const pageType = ref(0);
	const title = computed(() => {
		if (pageType.value == 0) {
			return i18n.global.t("common.btn_txt_create", [i18n.global.t('hotel.title_room_type')]);
		}
		const modify_title = i18n.global.t("common.btn_txt_modify", [i18n.global.t('hotel.title_room_type')]);
		const detail_title = i18n.global.t("common.btn_txt_details", [i18n.global.t('hotel.title_room_type')]);
		return pageType.value == 1 ? modify_title : detail_title;
	})
	let submitLoading = ref(false);
	const hotel_id = computed(() => {
		return state.hotel_id;
	});
	const user = computed<userBean>(() => {
		return state.user;
	});
	const cloudPath = computed(() => {
		return `/${hotel_id.value}/roomType/`;
	})
	let edit_roomType_id = ref("");//编辑房型id
	const roomTypeList = computed<Array<roomTypeBean>>(() => {
		return state.roomTypeList;
	});
	let bedTypeList = ref<bedType[]>([
		{ name: "1.8米", checked: false, count: 1 },
		{ name: "1.5米", checked: false, count: 1 },
		{ name: "1.3米", checked: false, count: 1 },
		{ name: "1.2米", checked: false, count: 1 }
	]);
	const bedTypeListFomat = computed<Array<bedBean>>(() => {
		let arr = bedTypeList.value.filter((item : bedType) => item.checked);
		return arr.map((item : bedType) => {
			return { name: item.name, count: item.count } as bedBean;
		})
	})
	const priceBase = ref("");

	let roomTypeForm = ref<roomTypeBean>({
		_id: "",
		hotel_id: hotel_id.value,
		name: "",
		area: 25,
		isWindow: true,
		guestNumber: 2,
		firstImages: "",
		imagesList: [],
		bedList: [],
		facility: [],
		priceBase: 0,
		roomList: [],
		independentBathroom: true
	});
	watch(priceBase, (val : string) => {
		roomTypeForm.value.priceBase = parseFloat(val);
	})
	const titleImg = computed<string>(() => {
		if (pageType.value == 0) {
			return "/static/icons/addpage.png"
		}
		return pageType.value == 1 ? "/static/icons/editpage.png" : "/static/icons/detailpage.png"
	})
	const facilityConfig_roomType = ref<Array<facilityConfig_type>>([]);
	const getConfig_facilityConfig = async () => {
		const list = await HotelService.getConfig_facilityConfig('roomType');
		facilityConfig_roomType.value = list;
	}
	//HotelService.getConfig_facilityConfig('roomType').then(list => {
	// 	facilityConfig_roomType.value = list;
	// });
	const addRoomType = async () => {
		submitLoading.value = true;
		try {
			const flag = await roomTypeService.addRoomType(roomTypeForm.value);
			if (flag) {
				await comFunction.getRoomTypeList(hotel_id.value);
				submitLoading.value = false;
				uni.navigateBack({
					success() {
						uni.showToast({
							title: i18n.global.t('common.add_success'),
							icon: "none"
						});
					}
				});

			}

		} catch (error) {
			submitLoading.value = false;
			uni.showToast({
				title: i18n.global.t('common.add_fail'),
				icon: "none"
			});
		}

	}
	const updateRoomType = async () => {
		submitLoading.value = true;
		//	const id = roomTypeForm.value._id._value as string;
		//roomTypeForm.value._id=roomType_id.value;
		const flag = await roomTypeService.updateRoomType(roomTypeForm.value);
		if (flag) {
			await comFunction.getRoomTypeList(hotel_id.value);
			submitLoading.value = false;
			uni.navigateBack();
		}

	}
	const submitForm = () => {
		//roomTypeForm.value.hotel_id=hotel_id.value;
		roomTypeForm.value.bedList = bedTypeListFomat.value;
		const flag : boolean = validRoomTypeForm(roomTypeForm.value);
		if (flag == false) {
			return;
		}
		if (pageType.value == 1) {
			updateRoomType();
			return;
		}
		addRoomType();
	}

	// 屋内设施勾选变化
	const recreationCheckboxChange = (e : string[]) => {
		roomTypeForm.value.facility = e
	}
	const uploadFirstImageSuccess = (list : string[]) => {
		console.log("得到的list：", list);
		roomTypeForm.value.firstImages = list[0];
	}
	const uploadImageListSuccess = (list : string[]) => {
		console.log("得到的list2：", list);
		roomTypeForm.value.imagesList = list;
	}

	onLoad(params => {
		getConfig_facilityConfig();
		try {
			const pt = params.getString("pageType") ?? "";
			const roomType_id = params.getString("roomType_id") ?? "";
			if (pt != "" && roomType_id != "") {
				edit_roomType_id.value = roomType_id;
				pageType.value = parseInt(pt);
				const item = roomTypeList.value.find(item => item._id == roomType_id);
				if (item != null) {
					priceBase.value = item.priceBase.toString();
					roomTypeForm.value = item;

				}
			}
		} catch (e) {
			console.error(e);
		}
	});
	onMounted(() => {
		for (let i = 0; i < bedTypeList.value.length; i++) {
			let obj : bedBean | null = roomTypeForm.value.bedList.find((it, index) => {
				const itemObj : bedBean = it;
				const name = itemObj['name'] as string;
				return name == bedTypeList.value[i].name;
			});
			if (obj != null) {
				bedTypeList.value[i].checked = true;
				bedTypeList.value[i].count = obj['count'] as number;
			}
		}
	})
</script>

<style lang="scss">
	.checkbox-group {
		display: flex;
		flex-direction: column;
	}
</style>