		title:i18n.global.t("order.orderManage") ,
		label:i18n.global.t("home.viewManageAllOrders"),//"查看与管理全部订单" ,
		bgColor: "#faad141a",
		url: "/pages/order/orderList/orderList"
	}
	]
</script>

