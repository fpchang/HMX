	async hotel_createHotel(hotelObj: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.hotel_createHotel({ hotelObj });
	}

	async hotel_updateHotel(hotel_id: string, hotelObj: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.hotel_updateHotel({ hotel_id, hotelObj });
	}

	async hotel_deleteHotel(hotel_id: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.hotel_deleteHotel({ hotel_id });
	}

	async hotel_getHotelList(): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
