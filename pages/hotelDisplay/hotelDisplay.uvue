<template>
	<rice-navbar title="" border>
		<template #left>
			<view style="display: flex;flex-direction: row;align-items: center;">
				<navigator open-type="navigateBack">
					<rice-icon name="arrow-left" size="22px" />
				</navigator>
				<image src="/static/icons/mine/hotel.png"
					style="width: 22px;height: 22px;margin-left: 15px;margin-right: 4px;"></image>
				<text style="font-size: 18px;font-weight: 700;color:#2a5d98;">{{hotel?.hotelName}}</text>
			</view>
		</template>
		<template #right>
			<view class="nav-tab-wrap">
				<rice-tabs v-model="activeIndex" :list="list" @clickTab="tabClick" line-color="#2a5d98"
					title-inactive-color="#4b5563" title-active-color="#2a5d98"></rice-tabs>
			</view>
		</template>
	</rice-navbar>

	<scroll-view class="scroll-main-view" style="flex:1">
		<view v-show="activeIndex==0">
			<view>
				<imageSwiperComponent :hotel="hotel" v-if="hotel!=null"></imageSwiperComponent>
			</view>
			<view class="info-block">
				<view class="info-title-row"><text class="info-title-text">{{hotel?.hotelName}}</text></view>
				<view class="info-addr-row">
					<image src="/static/icons/hoteldisplay/location.png" style="width: 16px;height: 16px;"></image>
					<text class="info-addr-text">{{hotel?.hotelAddress}}</text>
				</view>
			</view>
			<view class="content-container-block">
				<view class="container-title-row">
					<text class="container-title-text">酒店特色</text>
				</view>
				<view class="container-content-wrap">
					<view class="tag-row" style="display: flex;flex-direction: row;" v-if="hotel!=null">
						<view class="single-tag-box" v-for="item of hotel.feature">
							<rice-tag type="warning" :text="item" size="large" />
						</view>
					</view>
				</view>
			</view>
			<view class="content-container-block">
				<view class="container-title-row">
					<text class="container-title-text">酒店设施</text>
				</view>
				<view class="container-content-wrap">
					<services-facilities ref="servicesFacilitiesRes" :hotel_id="hotel_id"></services-facilities>
				</view>
			</view>
		</view>
		<view v-show="activeIndex==1">
			<roomTypeComponent :hotel_id="hotel_id"></roomTypeComponent>
		</view>
	</scroll-view>

	<swiper v-if="false" :current="activeIndex" style="flex: 1;background-color:#f8f9fa;" @change="swiperChange"
		:circular="true" class="tab-swiper-box" :style="{height: `${swiperHeight}px`}" touch-angle="35" duration="300">
		<swiper-item style="flex:1">
			<scroll-view class="scroll-main-view" style="flex:1">
				<view>
					<imageSwiperComponent :hotel="hotel" v-if="hotel!=null"></imageSwiperComponent>
				</view>
				<view class="info-block">
					<view class="info-title-row"><text class="info-title-text">{{hotel?.hotelName}}</text></view>
					<view class="info-addr-row">
						<image src="/static/icons/hoteldisplay/location.png" style="width: 16px;height: 16px;"></image>
						<text class="info-addr-text">{{hotel?.hotelAddress}}</text>
					</view>
				</view>
				<view class="content-container-block">
					<view class="container-title-row">
						<text class="container-title-text">酒店特色</text>
					</view>
					<view class="container-content-wrap">
						<view class="tag-row" style="display: flex;flex-direction: row;" v-if="hotel!=null">
							<view class="single-tag-box" v-for="item of hotel.feature">
								<rice-tag type="warning" :text="item" size="large" />
							</view>
						</view>
					</view>
				</view>
				<view class="content-container-block">
					<view class="container-title-row">
						<text class="container-title-text">酒店设施</text>
					</view>
					<view class="container-content-wrap">
						<services-facilities ref="servicesFacilitiesRes" :hotel_id="hotel_id"></services-facilities>
					</view>
				</view>
			</scroll-view>
		</swiper-item>
		<swiper-item style="flex:1">
			<scroll-view class="scroll-main-view" style="flex:1" :scroll-with-animation="true" enhanced bounces="false"
				fast-deceleration="true">
				<view>
					<roomTypeComponent :hotel_id="hotel_id"></roomTypeComponent>
				</view>
			</scroll-view>
		</swiper-item>
	</swiper>
</template>

<script setup>
	import { ref } from 'vue';
	import { TabsOptions, TabsClickTab, TabsChange } from '@/uni_modules/rice-ui';
	import imageSwiperComponent from "./components/imageSwiperComponent.uvue";
	import roomTypeComponent from "./components/roomTypeComponent/roomTypeComponent.uvue"
	import listComponent from "./components/listComponent/listComponent.uvue";
	import servicesFacilities from "./components/servicesFacilities.uvue"
	import { roomTypeService } from '@/services/roomTypeService';
	import { hotelBean } from '@/bean/hotelBean';
	import { roomTypeBean } from '@/bean/roomTypeBean';
	import { HotelService } from '@/services/HotelService';

	const servicesFacilitiesRes = ref<ComponentPublicInstance | null>(null);
	const hotel_id = ref("");
	const hotel = ref<hotelBean | null>(null);
	const roomTypeList = ref<Array<roomTypeBean> | null>(null);
	const activeIndex = ref(0);
	const list = ref<TabsOptions[]>([{
		name: '首页',
		value: 'recommedn'
	}, {
		name: '房型',
	}])
	const tabClick = (e : TabsClickTab) => {
		console.log('TabsClickTab', e)
	}
	const swiperChange = (event : UniSwiperChangeEvent) => {
		activeIndex.value = event.detail.current;
		console.log(event)
	}
	const initData = async () => {
		hotel.value = await HotelService.getHotelInfoById(hotel_id.value);
	}
	const swiperHeight = ref(0)
	const calcSwiperHeight = () => {
		const sys = uni.getSystemInfoSync()
		const navRPX = 80
		const navPx = uni.rpx2px(navRPX)
		swiperHeight.value = sys.windowHeight - navPx - sys.safeAreaInsets.bottom
	}
	onReady(() => {
		calcSwiperHeight()
	})
	onLoad(params => {
		console.log("params:", params);
		const h_id : string = params.getString("hotel_id") ?? "";
		if (h_id != null) {
			hotel_id.value = h_id;
			initData()
		}
	})
</script>

<style>
/* 导航栏tabs外层 */
.nav-tab-wrap {
}
/* 滚动容器 */
.scroll-main-view {
	width: 100%;
	height: 100%;
	background: #f5f5f5;
}
