<template>
	<view class="pt-6 px-3 mb-3">
		<text class="text-2xl font-bold mb-2 text-primary flex">SVG 矢量图标</text>
		<text class="text-sm text-secondary mb-4 flex">支持本地、网络、源文本和 Base64 格式的 SVG，可动态着色</text>

		<view class="bg-surface p-4 mb-4 rounded-xl">
			<text class="text-lg font-bold mb-4 text-primary flex">基础用法</text>
			<text class="text-sm text-secondary mb-3 flex">支持本地路径、网络 URL、SVG 源文本和 Base64 编码</text>
			<view class="flex-row flex-wrap mb-2">
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" src="/static/svg/a.svg"></l-svg>
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" src="https://www.xmplus.cn/uploads/images/20221228/b9e9d45054ab5795992a1e92584a278b.svg"></l-svg>
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" color="#e25121" src="data:image/svg+xml;base64,"></l-svg>
				 <l-svg  style="width: 36px;height: 36px;" :src="svg"  color="#60a5fa"></l-svg>
			</view>
		</view>

		<view class="bg-surface p-4 mb-4 rounded-xl">
			<text class="text-lg font-bold mb-4 text-primary flex">颜色着色</text>
			<text class="text-sm text-secondary mb-3 flex">通过 color 属性改变纯色 SVG 图标颜色</text>
			<view class="flex-row flex-wrap mb-2">
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" color="#1635F4" src="/static/svg/a.svg"></l-svg>
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" color="#e25121" src="/static/svg/qq.svg"></l-svg>
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" color="#07c160" src="/static/svg/weixin.svg"></l-svg>
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" color="#000000" src="/static/svg/apple.svg"></l-svg>
			</view>
		</view>

		<view class="bg-surface p-4 mb-4 rounded-xl">
			<text class="text-lg font-bold mb-4 text-primary flex">WebView 渲染</text>
			<text class="text-sm text-secondary mb-3 flex">通过 :web="true" 启用 WebView 渲染，支持动画</text>
			<view class="flex-row flex-wrap mb-2">
				<l-svg l-class="w-60px! h-60px! mr-3 mb-3" :web="true" src="https://www.xmplus.cn/uploads/images/20221228/b9e9d45054ab5795992a1e92584a278b.svg"></l-svg>
			</view>
		</view>

		<view class="bg-surface p-4 mb-4 rounded-xl">
			<text class="text-lg font-bold mb-4 text-primary flex">动态切换</text>
			<text class="text-sm text-secondary mb-3 flex">动态切换 src 和 color</text>
			<view class="flex-row flex-wrap items-center mb-2">
				<l-svg l-class="w-100px! h-100px! mr-3 mb-3" :src="isSwitch ? '/static/svg/qq.svg' : '/static/svg/weixin.svg'" :color="isSwitch ? '#1635F4' : '#07c160'"></l-svg>
				<button @click="isSwitch = !isSwitch">切换</button>
			</view>
		</view>
	</view>
</template>

<script setup>
	defineOptions({
		styleIsolation: 'app-and-page'
	})
		 const  svg=`<svg t="1755738138073" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="2275" width="200" height="200"><path d="M847.4112 197.888V186.88A89.7024 89.7024 0 0 0 757.76 97.28H291.3792A89.7536 89.7536 0 0 0 201.728 186.88v11.008A94.0032 94.0032 0 0 0 114.9952 291.84v429.824a94.0032 94.0032 0 0 0 86.7328 93.6448V844.8a71.3728 71.3728 0 0 0 71.2704 71.68h503.1936a71.3216 71.3216 0 0 0 71.2192-71.68v-29.4912a94.0032 94.0032 0 0 0 87.04-93.7984V291.84a94.0032 94.0032 0 0 0-87.04-93.952zM242.7392 186.88a48.7936 48.7936 0 0 1 48.64-48.64H757.76a48.7424 48.7424 0 0 1 48.5888 48.7424v9.216H242.7392zM776.192 875.1104H272.9984a30.3104 30.3104 0 0 1-30.2592-30.3104v-29.0816H806.4V844.8a30.3104 30.3104 0 0 1-30.208 30.3104z m116.992-153.6a52.992 52.992 0 0 1-46.08 52.3776h-645.12a52.992 52.992 0 0 1-46.08-52.3776V291.84a53.0432 53.0432 0 0 1 53.0432-53.1968h631.296A53.0432 53.0432 0 0 1 893.184 291.84z" p-id="2276"></path><path d="M698.2144 326.0416a180.1216 180.1216 0 0 0-27.9552-2.3552h-116.736v1.3824H369.4592a185.6 185.6 0 0 0 0 371.1488h310.2208a185.6 185.6 0 0 0 18.5344-370.176z m0 161.8432a31.5392 31.5392 0 1 1-31.4368 31.5392 31.488 31.488 0 0 1 31.6416-31.5392z m-31.4368-5.5808l31.4368-54.6304 31.4368 54.6304z m62.8736 74.2912l-31.4368 54.5792-31.4368-54.5792z m60.1088-37.1712l-54.4768 31.5392V487.8848z m-128.5632-31.5392v63.0784l-54.4768-31.5392zM225.28 510.6688a144.384 144.384 0 0 1 144.1792-144.4352h184.32V655.36h-184.32A144.4352 144.4352 0 0 1 225.28 510.6688z" p-id="2277"></path></svg> `
		 
	const isSwitch = ref(false)
</script>
