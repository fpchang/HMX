<template>
	<scroll-view style="flex:1;display: flex;flex-direction: column" :show-scrollbar="false">
		
		<view style="padding:20px">
			<view class="split-item" style="background-color: #f5f5f7;">
			<!-- 	<navigator url="./editUser/editUser">
					<view class="personal-container">
						<view style="display: flex;flex-direction: row;">
							<view class="user-info-section" style="flex-direction: column;flex: 1;">
								<image class="avatar" :src="avator" mode="aspectFill"></image>
								<text class="user-name">{{formatUserName}}</text>
								<text class="user-phone">{{emergency_phone_number((user.phone ?? '') as string)}}</text>
							</view>
							<view style="display: flex;flex-direction: row;align-items: center;">
								<rice-icon size="16px" name="arrow-right" />
							</view>
						</view>
					</view>
				</navigator> -->
				<view style="margin-top: 40px;">
				<rice-cell :border="false" :custom-style="{backgroundColor:'#f5f5f7'}"  :title="formatUserName" :label="emergency_phone_number((user.phone ?? '') as string)" center :arrow="true" url="/pages/mine/editUser/editUser">
				  <template #leftIcon>
				    <image :src="avator" class="left-cion" style="width: 80px;height: 80px;border-radius: 40px;margin-right: 8px;"></image>
				  </template>
				
				</rice-cell>
				</view>
			</view>
			
			<view class="split-item">
				<view class="title-wrap">
					<text class="title-txt">{{i18n.global.t("hotel.current_hotel")}}</text>
					<navigator url="/pages/hotelManage/hotelList/hotelList">
						<text class="title-btn">{{i18n.global.t("hotel.btn_txt_view_all")}}</text>
					</navigator>
				</view>
				
				<view class="hotel-card">
					<template v-if="hotel_id!=''">
						<view class="card-img-area">
							<image 
								:src="hotel?.firstImages" 
								v-if=" hotel!=null&&hotel?.firstImages!=''"
								style="height: 100%;width: 100%;" 
								mode="aspectFill"
							></image>
							<image 
								src="/static/images/noimg.png" 
								v-if="hotel?.firstImages==''"
								style="height: 40%;width: 40%;" 
								mode="aspectFit"
							></image>
						</view>
						<view class="card-bottom-wrap">
							<view class="card-text-wrap">
								<view class="card-main-title">
									<text class="main-txt">{{hotel?.hotelName}}</text>
								</view>
								<view class="card-sub-title">
									<image src="/static/icons/position_black.png" style="width:14px;height:14px;margin-right: 4px;"></image>
									<text class="sub-txt">{{hotel?.hotelAddress}}</text>
								</view>
							</view>
							<view class="hotel-state-tag">
								<text class="tag-txt">{{i18n.global.t('hotel.normal_operation')}}</text>
							</view>
						</view>
					</template>
					<view v-if="hotel_id==''">
						<l-empty :description="i18n.global.t('common.noData',[''])" />
					</view>
				</view>
			</view>

			<view class="split-item">
				<view class="title-wrap">
