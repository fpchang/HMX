import { DB } from '../api/DB';

const action_co = uniCloud.importObject("hm_action_co");

class ActionServiceClass {
	constructor() {}

	// ==================== 用户相关 ====================
	async user_login(userForm: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_login(userForm);
	}

	async user_register(userForm: UTSJSONObject): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_register(userForm);
	}

	async user_sendSms(phone: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_sendSms({ phone });
	}

	async user_validToken(): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_validToken({});
	}

	async user_getUser(type: string, value: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_getUser({ type, value });
	}

	async user_closeAccount(): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_closeAccount({});
	}

	async user_checkLogin(): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_checkLogin({});
	}

	async user_loginMp(code: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_loginMp({ code });
	}

	async user_validEmailAndCode(email: string, emailCode: string, emailCodeTk: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_validEmailAndCode(email, emailCode, emailCodeTk);
	}

	async user_updatePassword(password: string, originPassword: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		const token = uni.getStorageSync("hm_token");
		return await action_co.user_updatePassword(token, password, originPassword);
	}

	async user_resetPasswordByEmailCode(email: string, emailCode: string, emailCodeTk: string, password: string): Promise<UniCloudCallFunctionResult<UTSJSONObject>> {
		return await action_co.user_resetPasswordByEmailCode(email, emailCode, emailCodeTk, password);
	}

