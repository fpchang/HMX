<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<rice-dialog v-model:show="showMoreMessage" :title="i18n.global.t('dialog.welcomeTitle')"
			:show-cancel-button="true" :show-confirm-button="true"
			:cancel-button-text="i18n.global.t('dialog.refuseExit')"
			:confirm-button-text="i18n.global.t('dialog.agreeUse')" @cancel="calcelEvent" :before-close="beforeClose"
			@confirm="confirmEvent" :use-dialog-page="true" :custom-style="{'padding':0}">
			<slot>
				<scroll-view class="message-content">
					<view>
						<text class="linktxt">
							{{ i18n.global.t('dialog.tipRead') }}
						</text>
						<view class="row">
							<text class="linktxt">{{ i18n.global.t('dialog.youCanRead') }}</text>
							<navigator url="/pages/common/userAgreement/userAgreement">
								<text class="linktxt linkhref">{{ i18n.global.t('dialog.serviceAgreement') }}</text>
							</navigator>

							<text class="linktxt">{{ i18n.global.t('dialog.and') }}</text>
							<navigator url="/pages/common/privacyPolicy/privacyPolicy">
								<text class="linktxt linkhref">{{ i18n.global.t('dialog.privacyPolicy') }}</text>
							</navigator>

							<text class="linktxt">{{ i18n.global.t('dialog.tipContinue') }}</text>
						</view>
						<text class="linktxt" v-for="item of messages">{{ item }}</text>
					</view>
				</scroll-view>
				<view class="agreen-style" v-if="false">
					<rice-checkbox v-model="agreen" />
					<text class="agreen-style-txt">我已阅读并同意</text>
					<navigator url="/pages/common/userAgreement/userAgreement">
						<text class="linktxt linkhref">{{ i18n.global.t('dialog.serviceAgreement') }}</text>
					</navigator>
					<text class="linktxt">{{ i18n.global.t('dialog.and') }}</text>
					<navigator url="/pages/common/privacyPolicy/privacyPolicy">
						<text class="linktxt linkhref">{{ i18n.global.t('dialog.privacyPolicy') }}</text>
					</navigator>
				</view>
			</slot>
		<template #footer>
			<view class="footer">
				
				<view class="footer-item">
					<button class="btn" type="primary" open-type="agreePrivacyAuthorization" @click="beforeClose">{{i18n.global.t('dialog.agreeUse')}}</button>
				</view>
				<view class="footer-item" style="text-align: center;">
					<text class="txt-cancel" @click="calcelEvent">{{i18n.global.t('dialog.refuseExit')}}</text>
				</view>
			</view>
		</template>
		</rice-dialog>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	
	<!--  open-type="agreePrivacyAuthorization"-->
</template>

<script setup>
	import { action_co } from "@/api/cloudApi.uts";
	import { setToken, setViewWidth } from "@/store/store.uts";
	import i18n from '@/i18n/index.uts';

	const showMoreMessage = ref(true);
	const agreen = ref(true);
	const messages = [
		i18n.global.t('dialog.msg1'),
		i18n.global.t('dialog.msg2'),
		i18n.global.t('dialog.msg3'),
		i18n.global.t('dialog.msg4'),
		i18n.global.t('dialog.msg5'),
		i18n.global.t('dialog.msg6'),
		i18n.global.t('dialog.msg7'),
		// i18n.global.t('dialog.msg8'),
		// i18n.global.t('dialog.msg9')
	]
	const calcelEvent = () => {
		uni.exit();
	}
	const start = () => {
		setTimeout(() => {
			try {
				// 调用云对象空/轻量方法，触发云端实例常驻，消除首次接口冷启动
				action_co.preHeat()
			} catch (e) {
				// 预热失败不影响业务，静默捕获
				// console.log('云对象预热静默失败', e)
			}
		}, 0)
	}

	const setLanuage = () => {

		const sys = uni.getSystemInfoSync();
		console.log('sys', sys);
		const osLanguage = sys.osLanguage;
		let local = 'zh-CN';
		console.log(osLanguage != null)
		if (osLanguage != null && !osLanguage.includes('zh-')) {
			local = 'en-US';
		}
		i18n.global.locale.value = local;

	}
	const setViewWidthEvent = () => {
		const win = uni.getWindowInfo();
		setViewWidth(win.windowWidth);
	}
	const beforeClose = () : Promise<boolean> => {
		return new Promise((resolve) => {
			if (!agreen.value) {
				uni.showToast({
					title: i18n.global.t("login.valid_agree"),
					icon: "none"
				})
				resolve(false);
				return;
			}
			// uni.getPrivacySetting({
			// 			success: (res) => {
			// 				console.log("获取隐私是否同意",res);
			// 				//uni.resetPrivacyAuthorization()
			// 			}
			// 		})
			resolve(true);
			uni.setStorageSync("showMoreMessage","0");
			uni.closeDialogPage();
			uni.reLaunch({
				url:"/pages/indexAdvise/indexAdvise"
			})
		})
	}
	const confirmEvent = () => {
	

	}
	//uni.getPrivacySetting 获取是否同意隐私
	//
	
	// uni.getPrivacySetting({
	// 			success: (res) => {
	// 				console.log("获取隐私是否同意",res);
	// 				//uni.resetPrivacyAuthorization()
	// 			}
	// 		})
</script>

<style lang="scss">
	.message-content {
		max-height: 350px;

		.row {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
		}

	
	}
	.linktxt {
			font-size: 12px;
			color: gray;
			padding: 4px 0;

		}

		.linkhref {
			color: #165dff;
			font-size: 12px;
		}
	.agreen-style {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-top: 24px;
	}

	.agreen-style-txt {

		font-size: 12px;
	}
	.footer{	
		flex:1;
		padding-bottom:4px;
	}
	.footer-item{
		margin-bottom:8px;
		padding:0 14px;
	}
	.btn{
		border-radius:20px;
		height:40px;
		line-height:40px;
		font-size:14px;
	}
	.txt-cancel{
		font-size:14px;
		color:#999;
		text-align:center;
	}
</style>