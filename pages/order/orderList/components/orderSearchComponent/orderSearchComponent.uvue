<template>
	<view class="fm-search-root">
		<view class="search-select-item" style="min-width:320px">
			
				<!-- <l-space :wrap="true" :fill="true"> 
					<view style="min-width: 60px;" v-for="item of checkType"><rice-button
							:type="orderType==item.value?'primary':'info'" size="small" :text="item.text"
							@click="checkTypeEvent(item.value)"></rice-button></view>
				</l-space> -->
				
				<view style="display: flex;flex-direction: row;align-items: center;">
				
					<view style="margin-right: 8px" v-for="item of checkType">
						<rice-button
								:type="orderType==item.value?'primary':'info'" size="small" :text="item.text"
								@click="checkTypeEvent(item.value)"></rice-button>
					</view>
					
				</view>
		</view>
			<view class="search-select-item">
				<view class="select-box">
					<view class="select-content" @click="showCalendarEvent">
						<text class="select-txt">{{dateRange.join(" ~ ") }}</text>
						<image src="/static/icons/calendar.png" style="width: 20px;height:20px"></image>
					</view>
				</view>
			</view>
			<view class="search-select-item">
				<view class="select-box" style="padding-right: 8px;">
					<rice-search v-model="keystr" input-color="#fff" :clearable="false" :placeholder="placeholder"
						:custom-style="{'padding':0}" @search="searchEvent" @clickLeftIcon="searchEvent"
						@input="searchInputChange" @clickAction="searchEvent" show-action left-icon=""
						action-color="#007aff" :action-text="i18n.global.t('common.btn_txt_search')" />
				</view>
			</view>
			<rice-calendar :show="showCalendar" mode="range" :date="dateRange"
				@confirm="rangeConfirm"></rice-calendar>
	
		</view>
</template>

<script setup>
	import { PickerOption, PickerEvent } from "@/uni_modules/rice-ui/index";
	import { ActionSheetAction } from "@/uni_modules/rice-ui";
	import { dayuts } from '@/uni_modules/lime-dayuts';
	import { TIME, MOONTH_START_END_TIMESTAMP, getMonthDateArray } from "@/static/utils/TIME";
	import i18n from '@/i18n/index.uts';
	defineOptions({
		styleIsolation: "isolated"
	})
	const emit = defineEmits(['selectAction', "searchAction", "searchInputChange", "dateChange"]);
	const props = defineProps({
		initDateRange: {
			type: Array<String>,
			default: []
		},
		placeholder: {
			type: String,
			default: i18n.global.t("common.search_txt")
		}
	});
	type TYPE_ORDER = {
		text : string,
		value : string | number
	}
	const checkType : Array<TYPE_ORDER> = [
		{ text: i18n.global.t('order.statusAll'), value: "all" },
		{ text: i18n.global.t('order.statusCheckInPending'), value: 1 },
		{ text: i18n.global.t('order.statusCompleted'), value: 5 },
		{ text: i18n.global.t('order.statusCancelled'), value: 10 },
	]
	const attrs = useAttrs();
	let showPicker = ref(false);
	let showCalendar = ref(false);
	const billType = ref("income");
	let text_val = ref(i18n.global.t("common.select_txt"));
	let keystr = ref("");
	const orderType = ref<string | number>('all');
	const dateRange = ref<string[]>(props.initDateRange);
	const checkTypeEvent = (id : string | number) => {
		orderType.value = id;
		emit("selectAction", id);
	}
	const showSelect = () => {
		showPicker.value = !showPicker.value;
	}
	const showCalendarEvent = () => {
		showCalendar.value = !showCalendar.value;
	}
	const searchEvent = () => {
		emit("searchAction", orderType.value, dateRange.value, keystr.value);
	}
	const searchInputChange = (value : string) => {
		emit("searchInputChange", value);
	}
	const rangeConfirm = (e : string[]) => {
		emit("dateChange", e);
		//dateRange.value = e;
	}
</script>

<style>
	/* 外层容器 */
	.fm-search-root {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	/* 每一项筛选容器 */
	.search-select-item {
		margin-bottom: 12px;
		min-width: 280px;
		flex: 1;
	}

	/* 下拉选择外框 */
	.select-box {
		position: relative;
		border: 1px solid #dcdfe6;
		box-sizing: border-box;
		overflow: visible;
		border-radius: 4px;
	}

	/* 选择框内部内容行 */
	.select-content {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 36px;
		padding: 0 8px;
		overflow: visible;
	}

	/* 选择框文字 */
	.select-txt {
		line-height: 36px;
	}

	/* 弹窗面板容器 */
	.center-panal {
		padding: 16px;
		border-radius: 8px;
		background-color: #f1f1f1;
	}

	/* 下拉列表容器 */
	.select-list {
		min-width: 250px;
		overflow: visible;
		background-color: #fff;
	}

	/* 下拉列表单项 */
	.select-list-item {
		padding: 8px;
	}

	/* 列表文字样式 */
	.list-item-txt {
		color: #eee;
	}
</style>